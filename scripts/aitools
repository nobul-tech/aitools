#!/usr/bin/env bash
# aitools -- pull latest ai-tooling scaffolding and manage dev tools
# Installed to ~/.local/bin/ by scripts/aitools-install.{sh,ps1}
#
# The entire script is wrapped in main() so bash reads it fully into memory
# before executing. This prevents corruption when the installer overwrites
# this file on disk during Step 6.

AITOOLS_INSTALLED_VERSION="dev"

main() {

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Read a top-level string value from a JSON config file.
# Handles UTF-8 BOM (PowerShell 5.x writes one) and JSON-escaped backslashes.
read_config_key() {
    local file="$1" key="$2"
    [ -f "$file" ] || return 1
    local val
    val=$(tr -d '\357\273\277' < "$file" \
        | grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" \
        | head -1 \
        | cut -d'"' -f4)
    [ -n "$val" ] || return 1
    # Unescape JSON backslashes: \\ -> \
    printf '%b' "$val"
}

# Convert a Windows path to Unix-style for Git Bash / MSYS2. No-op elsewhere.
to_native_path() {
    if command -v cygpath &>/dev/null; then
        cygpath -u "$1"
    else
        printf '%s' "$1"
    fi
}

# Display-friendly path for user-facing messages (native Windows on MSYS).
display_path() {
    if command -v cygpath &>/dev/null; then
        cygpath -w "$1"
    else
        printf '%s' "$1"
    fi
}

# Version string from a git repo: "YYYY-MM-DD (hash)"
repo_version() {
    git -C "$1" log -1 --format='%cd (%h)' --date=short 2>/dev/null || echo "unknown"
}

# ---------------------------------------------------------------------------
# MCP server registry
# ---------------------------------------------------------------------------

# Returns URL for a known MCP server name, or empty string if unknown.
mcp_server_url() {
    case "$1" in
        vercel)  echo "https://mcp.vercel.com" ;;
        webflow) echo "https://mcp.webflow.com/mcp" ;;
        *)       echo "" ;;
    esac
}

# ---------------------------------------------------------------------------
# Usage / flags
# ---------------------------------------------------------------------------

usage() {
    cat <<'EOF'
Usage: aitools [COMMAND] [OPTIONS]

Commands:
  (none)               Pull latest and rebuild deploy scripts (self-update)
  install              Install/update all tools and deploy configurations
  mcp                  Show MCP server status for current project

Options:
  --addmcp <name...>   Enable MCP server(s) for current project (vercel, webflow)
  --version, -v        Show installed and repo version
  --help, -h           Show this help

Install flags (passed through to installer):
  --skip-gh-auth       Skip GitHub CLI authentication
  --repos-path PATH    Set repos directory without prompting
  --skip-drive-detection  Skip Google Drive auto-detection
EOF
}

show_version=false
show_help=false
do_install=false
do_mcp_status=false
addmcp_servers=()
passthrough=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --version|-v) show_version=true; shift ;;
        --help|-h)    show_help=true; shift ;;
        install)      do_install=true; shift ;;
        mcp)          do_mcp_status=true; shift ;;
        --addmcp)
            shift
            # Collect all following args that don't start with --
            while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
                addmcp_servers+=("$1")
                shift
            done
            ;;
        *)            passthrough+=("$1"); shift ;;
    esac
done

if $show_help; then
    usage
    return 0
fi

# ---------------------------------------------------------------------------
# Resolve repo path from config
# ---------------------------------------------------------------------------

config="$HOME/.config/ai-tooling/config.json"
repo_path=""

if raw=$(read_config_key "$config" "aiToolingRepoPath"); then
    repo_path=$(to_native_path "$raw")
fi
repo_path="${repo_path:-$HOME/repos/ai-tooling}"

# ---------------------------------------------------------------------------
# --version
# ---------------------------------------------------------------------------

if $show_version; then
    echo "aitools $AITOOLS_INSTALLED_VERSION"
    if [ -d "$repo_path/.git" ]; then
        echo "  repo: $(repo_version "$repo_path") @ $(display_path "$repo_path")"
    fi
    return 0
fi

# ---------------------------------------------------------------------------
# mcp — show MCP server status
# ---------------------------------------------------------------------------

if $do_mcp_status; then
    if ! command -v node &>/dev/null; then
        echo "error: node required for mcp status"
        return 1
    fi

    node -e '
const fs = require("fs");
const path = require("path");
const os = require("os");

const home = os.homedir();
const cwd = process.cwd();

function readJson(f) {
    try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; }
}

// --- Claude Code ---
const claudeJson = readJson(path.join(home, ".claude.json"));
const claudeSettings = readJson(path.join(home, ".claude", "settings.json"));
const projectSettings = readJson(path.join(cwd, ".claude", "settings.json"));
const projectLocalSettings = readJson(path.join(cwd, ".claude", "settings.local.json"));

const claudeDeny = claudeSettings?.permissions?.deny || [];
const projectAllow = [
    ...(projectSettings?.permissions?.allow || []),
    ...(projectLocalSettings?.permissions?.allow || []),
];

console.log("MCP Server Status (" + cwd + ")\n");

if (claudeJson?.mcpServers) {
    console.log("Claude Code:");
    const servers = claudeJson.mcpServers;
    for (const [name, cfg] of Object.entries(servers)) {
        const transport = cfg.type === "http" || cfg.url ? "http" : "stdio";
        const denyPattern = "MCP(" + name + ")";
        const denied = claudeDeny.includes(denyPattern);
        const allowed = projectAllow.includes(denyPattern);
        const status = denied && !allowed ? "disabled" : "enabled";
        const pad = name.length < 16 ? " ".repeat(16 - name.length) : " ";
        console.log("  " + name + pad + status.padEnd(10) + "(user)   " + transport);
    }

    // Show project overrides if any
    const overrides = [];
    for (const rule of projectAllow) {
        const match = rule.match(/^MCP\((.+)\)$/);
        if (match) {
            const source = projectLocalSettings?.permissions?.allow?.includes(rule)
                ? ".claude/settings.local.json"
                : ".claude/settings.json";
            overrides.push({ name: match[1], source });
        }
    }
    if (overrides.length > 0) {
        console.log("  Project overrides:");
        for (const o of overrides) {
            const pad = o.name.length < 16 ? " ".repeat(16 - o.name.length) : " ";
            console.log("    " + o.name + pad + "enabled   (" + o.source + ")");
        }
    }
} else {
    console.log("Claude Code: no user-level MCP config found (~/.claude.json)");
}

console.log("");

// --- Cursor ---
const cursorJson = readJson(path.join(home, ".cursor", "mcp.json"));
const projectCursorJson = readJson(path.join(cwd, ".cursor", "mcp.json"));

if (cursorJson?.mcpServers) {
    console.log("Cursor:");
    const servers = cursorJson.mcpServers;
    for (const [name, cfg] of Object.entries(servers)) {
        const transport = cfg.url ? "http" : "stdio";
        // We cannot programmatically detect Cursor disable state from JSON alone
        const pad = name.length < 16 ? " ".repeat(16 - name.length) : " ";
        console.log("  " + name + pad + "(user)   " + transport);
    }
    if (projectCursorJson?.mcpServers) {
        console.log("  Project overrides (.cursor/mcp.json):");
        for (const [name, cfg] of Object.entries(projectCursorJson.mcpServers)) {
            const transport = cfg.url ? "http" : "stdio";
            const pad = name.length < 16 ? " ".repeat(16 - name.length) : " ";
            console.log("    " + name + pad + "enabled   " + transport);
        }
    }
} else {
    console.log("Cursor: no user-level MCP config found (~/.cursor/mcp.json)");
}
'
    return 0
fi

# ---------------------------------------------------------------------------
# --addmcp — enable MCP server(s) for current project
# ---------------------------------------------------------------------------

if [ ${#addmcp_servers[@]} -gt 0 ]; then
    # Validate all server names first
    for name in "${addmcp_servers[@]}"; do
        url=$(mcp_server_url "$name")
        if [ -z "$url" ]; then
            echo "error: unknown MCP server '$name'"
            echo "Supported servers: vercel, webflow"
            return 1
        fi
    done

    # Warn if cwd doesn't look like a project
    if [ ! -d ".git" ] && [ ! -f "package.json" ] && [ ! -f "pyproject.toml" ]; then
        echo "warning: current directory doesn't look like a project root"
        echo "  cwd: $(display_path "$(pwd)")"
        echo ""
    fi

    for name in "${addmcp_servers[@]}"; do
        url=$(mcp_server_url "$name")
        echo "Enabling $name for this project..."

        # --- Claude Code: .claude/settings.local.json (allow override) ---
        settings_local=".claude/settings.local.json"
        if command -v node &>/dev/null; then
            mkdir -p .claude
            node -e "
const fs = require('fs');
const f = process.argv[1];
let settings = {};
try { settings = JSON.parse(fs.readFileSync(f, 'utf8')); } catch {}
if (!settings.permissions) settings.permissions = {};
if (!Array.isArray(settings.permissions.allow)) settings.permissions.allow = [];
const rule = 'MCP($name)';
if (!settings.permissions.allow.includes(rule)) {
    settings.permissions.allow.push(rule);
}
fs.writeFileSync(f, JSON.stringify(settings, null, 2) + '\n');
" "$settings_local"
            echo "  Claude Code: $name enabled in $settings_local"
        else
            echo "  Claude Code: skipped (node not found)"
        fi

        # --- Cursor: try agent mcp enable, fall back to project .cursor/mcp.json ---
        cursor_done=false
        if command -v agent &>/dev/null; then
            if agent mcp enable "$name" 2>&1; then
                echo "  Cursor CLI: $name enabled (agent mcp enable)"
                cursor_done=true
            fi
        fi
        if ! $cursor_done && command -v node &>/dev/null; then
            cursor_mcp=".cursor/mcp.json"
            mkdir -p .cursor
            node -e "
const fs = require('fs');
const f = process.argv[1];
let cfg = {};
try { cfg = JSON.parse(fs.readFileSync(f, 'utf8')); } catch {}
if (!cfg.mcpServers) cfg.mcpServers = {};
cfg.mcpServers['$name'] = { url: '$url' };
fs.writeFileSync(f, JSON.stringify(cfg, null, 2) + '\n');
" "$cursor_mcp"
            echo "  Cursor: $name added to $cursor_mcp"
        fi
        if ! $cursor_done && ! command -v node &>/dev/null; then
            echo "  Cursor: skipped (neither agent nor node found)"
        fi

        echo ""
    done

    echo "Done. MCP servers enabled for project at $(display_path "$(pwd)")"
    return 0
fi

# ---------------------------------------------------------------------------
# Verify repo exists
# ---------------------------------------------------------------------------

if [ ! -d "$repo_path/.git" ]; then
    echo "error: ai-tooling repo not found at $(display_path "$repo_path")"
    echo "Clone it first, then re-run the installer."
    return 1
fi

# ---------------------------------------------------------------------------
# Run update (pull + rebuild)
# ---------------------------------------------------------------------------

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ai-tooling"
[ "$(uname -s)" = "Darwin" ] && LOG_DIR="$HOME/Library/Logs/ai-tooling"
LOG_FILE="$LOG_DIR/deploy.log"
mkdir -p "$LOG_DIR"

# Display-friendly path for user-facing messages
LOG_DISPLAY=$(display_path "$LOG_FILE")

export AITOOLS_RUN_ID=$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')

echo "aitools $AITOOLS_INSTALLED_VERSION"
echo ""

if $do_install; then
    # install: pull + rebuild + run installer
    STEPS=3
    STEP_LABEL="install"
else
    # default: pull + rebuild only
    STEPS=2
    STEP_LABEL="sync"
fi

# [1/N] Pull latest
echo "[1/$STEPS] Pulling latest..."
pulled_updates=false
if pull_out=$(cd "$repo_path" && git pull origin main 2>&1); then
    if echo "$pull_out" | grep -q "Already up to date"; then
        echo "  Already up to date."
    else
        pulled_updates=true
        echo "  Updated."
    fi
else
    echo "  error: git pull failed" >&2
    echo "$pull_out" >&2
    return 1
fi

# [2/N] Rebuild deploy scripts
echo "[2/$STEPS] Rebuilding deploy scripts..."
if bash "$repo_path/scripts/build-deploy.sh" >> "$LOG_FILE" 2>&1; then
    echo "  Done."
else
    echo "  error: build failed (see $LOG_DISPLAY)" >&2
    return 1
fi

if $do_install; then
    # [3/3] Run installer (output visible to user)
    echo "[3/$STEPS] Running installer..."
    echo ""
    case "$(uname -s)" in
        MINGW*|MSYS*)
            # Windows: use PowerShell installer (runs all 4 deploy scripts)
            ps_args=()
            for arg in "${passthrough[@]}"; do
                case "$arg" in
                    --skip-gh-auth)         ps_args+=("-SkipGhAuth") ;;
                    --skip-drive-detection) ps_args+=("-SkipDriveDetection") ;;
                    --repos-path)           ps_args+=("-ReposPath") ;;
                    *)                      ps_args+=("$arg") ;;
                esac
            done
            powershell.exe -NoProfile -ExecutionPolicy Bypass \
                -File "$(cygpath -w "$repo_path/scripts/aitools-install.ps1")" \
                "${ps_args[@]}"
            ;;
        *)
            bash "$repo_path/scripts/aitools-install.sh" "${passthrough[@]}" < /dev/null
            ;;
    esac
    installer_rc=$?
    echo ""
    if [ $installer_rc -eq 0 ]; then
        echo "All up to date. ($(repo_version "$repo_path"))"
    else
        echo "Completed with errors (see $(display_path "$LOG_FILE"))."
    fi
else
    echo ""
    if $pulled_updates; then
        echo "Updated. ($(repo_version "$repo_path"))"
        # Show what changed
        cd "$repo_path" && git log --oneline ORIG_HEAD..HEAD 2>/dev/null | while read -r line; do
            echo "  $line"
        done
        echo ""
        echo "Run 'aitools install' to apply changes."
    else
        echo "Synced. ($(repo_version "$repo_path"))"
        echo "Run 'aitools install' to deploy configurations."
    fi
fi

# Self-update: bake version into installed copy AFTER installer
# (installer Step 6 copies the source file, so we must re-stamp after)
if [ -f "$repo_path/scripts/aitools" ]; then
    new_version=$(repo_version "$repo_path")
    sed "s/^AITOOLS_INSTALLED_VERSION=.*/AITOOLS_INSTALLED_VERSION=\"$new_version\"/" \
        "$repo_path/scripts/aitools" > "$HOME/.local/bin/aitools"
    chmod +x "$HOME/.local/bin/aitools"
fi

unset AITOOLS_RUN_ID

}

main "$@"; exit
