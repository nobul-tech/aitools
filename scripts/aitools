#!/usr/bin/env bash
# aitools -- pull latest aitools scaffolding and manage dev tools
# Installed to ~/.local/bin/ by scripts/aitools-install.{sh,ps1}
#
# The entire script is wrapped in main() so bash reads it fully into memory
# before executing. This prevents corruption when the installer overwrites
# this file on disk during Step 6.

AITOOLS_INSTALLED_VERSION="dev"

main() {

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Read a top-level string value from a JSON config file.
# Handles UTF-8 BOM (PowerShell 5.x writes one) and JSON-escaped backslashes.
read_config_key() {
    local file="$1" key="$2"
    [ -f "$file" ] || return 1
    local val
    val=$(tr -d '\357\273\277' < "$file" \
        | grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" \
        | head -1 \
        | cut -d'"' -f4)
    [ -n "$val" ] || return 1
    # Unescape JSON backslashes: \\ -> \
    printf '%b' "$val"
}

# Convert a Windows path to Unix-style for Git Bash / MSYS2. No-op elsewhere.
to_native_path() {
    if command -v cygpath &>/dev/null; then
        cygpath -u "$1"
    else
        printf '%s' "$1"
    fi
}

# Display-friendly path for user-facing messages (native Windows on MSYS).
display_path() {
    if command -v cygpath &>/dev/null; then
        cygpath -w "$1"
    else
        printf '%s' "$1"
    fi
}

# Check profile.json for issues and optionally prompt for fixes.
# Usage: check_profile <warn|interactive>
# Requires: node, $repo_path, $config
check_profile() {
    local mode="${1:-warn}"
    command -v node &>/dev/null || return 0
    [ -d "$repo_path" ] || return 0

    local check_script="$repo_path/scripts/profile-check.js"
    [ -f "$check_script" ] || return 0

    local result
    result=$(node "$check_script" --config "$config" 2>/dev/null) || return 0

    local status
    status=$(printf '%s' "$result" | node -e "
        let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
            try{console.log(JSON.parse(d).status)}catch{console.log('error')}
        })
    " 2>/dev/null)

    case "$status" in
        ok|unconfigured) return 0 ;;
        error)
            local msg
            msg=$(printf '%s' "$result" | node -e "
                let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
                    try{const r=JSON.parse(d);console.log((r.issues[0]&&r.issues[0].message)||'profile.json has issues')}catch{console.log('profile.json has issues')}
                })
            " 2>/dev/null)
            printf '\033[33mprofile: %s\033[0m\n' "$msg"
            ;;
        warn)
            # Print each issue as a warning
            printf '%s' "$result" | node -e "
                let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
                    try{const r=JSON.parse(d);r.issues.forEach(i=>console.log(i.message))}catch{}
                })
            " 2>/dev/null | while IFS= read -r line; do
                printf '\033[33mprofile: %s\033[0m\n' "$line"
            done
            if [ "$mode" = "interactive" ] && [ -t 0 ]; then
                printf '\033[33mRun '\''aitools user init'\'' to fix.\033[0m\n'
            fi
            ;;
        migrate)
            printf '\033[33mprofile: profile.json is v1 (legacy). Migration to v2 recommended.\033[0m\n'
            if [ "$mode" = "interactive" ] && [ -t 0 ]; then
                printf "Migrate profile.json to v2 now? [y/N]: "
                read -r answer < /dev/tty
                if [[ "$answer" =~ ^[Yy] ]]; then
                    migrate_profile_v1_to_v2 "$result"
                fi
            fi
            ;;
    esac
}

# Migrate a v1 profile.json to v2 format.
# Usage: migrate_profile_v1_to_v2 <profile-check-json-output>
# Prompts for machineAlias (only field not in v1). Preserves non-v1 sections
# (e.g., cursor). Commits + pushes user repo.
migrate_profile_v1_to_v2() {
    local check_result="$1"

    # Extract migration defaults
    local defaults
    defaults=$(printf '%s' "$check_result" | node -e "
        let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
            try{
                const r=JSON.parse(d);
                const m=r.migrationData||{};
                console.log(m.name||'');
                console.log(m.email||'');
                console.log(m.github||'');
                console.log(m.company||'');
                console.log(r.profilePath||'');
            }catch{}
        })
    " 2>/dev/null)

    local mig_name mig_email mig_github mig_company profile_path
    mig_name=$(echo "$defaults" | sed -n '1p')
    mig_email=$(echo "$defaults" | sed -n '2p')
    mig_github=$(echo "$defaults" | sed -n '3p')
    mig_company=$(echo "$defaults" | sed -n '4p')
    profile_path=$(echo "$defaults" | sed -n '5p')

    if [ -z "$profile_path" ] || [ ! -f "$profile_path" ]; then
        printf '\033[33mprofile: cannot locate profile.json for migration\033[0m\n'
        return 1
    fi

    local user_repo_dir
    user_repo_dir=$(dirname "$profile_path")

    # Prompt for machine alias (not in v1)
    printf "Machine alias for this machine (e.g., laptop, workstation): "
    read -r machine_alias < /dev/tty

    if [ -z "$machine_alias" ]; then
        echo "Migration cancelled (alias required)."
        return 1
    fi

    local shell_name
    shell_name=$(basename "${SHELL:-/bin/bash}")

    # Write v2 profile, preserving non-v1 sections
    node -e "
const fs = require('fs'), os = require('os');
const profilePath = process.argv[1];
const alias = process.argv[2];
const migName = process.argv[3];
const migEmail = process.argv[4];
const migGithub = process.argv[5];
const migCompany = process.argv[6];
const shellName = process.argv[7];

let old = {};
try { old = JSON.parse(fs.readFileSync(profilePath, 'utf8')); } catch {}

// Build v2 profile
const v2 = {
    version: 2,
    identity: {
        github: migGithub,
        email: migEmail,
        git: { name: migName, email: migEmail }
    },
    profiles: {}
};

v2.profiles[alias] = {
    name: migName,
    company: migCompany,
    machine: {
        hostname: os.hostname(),
        os: process.platform,
        arch: process.arch,
        shell: shellName
    }
};

// Preserve non-v1 sections (e.g., cursor)
const v1Keys = ['name', 'email', 'github', 'company', 'git', 'machines', 'version'];
for (const key of Object.keys(old)) {
    if (!v1Keys.includes(key) && !(key in v2)) {
        v2[key] = old[key];
    }
}

// Handle multiple machines from v1 (add non-current ones with generated aliases)
if (Array.isArray(old.machines)) {
    const currentHost = os.hostname().split('.')[0];
    let counter = 1;
    for (const m of old.machines) {
        const mHost = (m.hostname || '').split('.')[0];
        if (mHost === currentHost) continue;
        const mAlias = 'machine' + counter;
        counter++;
        if (!v2.profiles[mAlias]) {
            v2.profiles[mAlias] = {
                name: migName,
                company: migCompany,
                machine: m
            };
        }
    }
}

fs.writeFileSync(profilePath, JSON.stringify(v2, null, 2) + '\n');
console.log('Migrated profile.json to v2 (alias: ' + alias + ')');
" "$profile_path" "$machine_alias" "$mig_name" "$mig_email" "$mig_github" "$mig_company" "$shell_name"

    # Update machineAlias in config.json
    node -e "
const fs = require('fs');
const f = process.argv[1];
let cfg = {};
try { cfg = JSON.parse(fs.readFileSync(f, 'utf8')); } catch (e) { if (e.code !== 'ENOENT') console.error('Warning: ' + f + ' is invalid JSON, starting with empty config'); }
cfg.machineAlias = process.argv[2];
fs.writeFileSync(f, JSON.stringify(cfg, null, 2) + '\n');
" "$config" "$machine_alias"

    # Commit and push user repo
    if [ -d "$user_repo_dir/.git" ]; then
        if [ -n "$(git -C "$user_repo_dir" status --porcelain)" ]; then
            local git_name git_email
            git_name=$(node -e "try{const p=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'));console.log(p.identity.git.name||'')}catch{}" "$profile_path" 2>/dev/null)
            git_email=$(node -e "try{const p=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'));console.log(p.identity.git.email||'')}catch{}" "$profile_path" 2>/dev/null)
            if [ -n "$git_name" ] && [ -n "$git_email" ]; then
                git -C "$user_repo_dir" config user.name "$git_name"
                git -C "$user_repo_dir" config user.email "$git_email"
            fi
            git -C "$user_repo_dir" add -A
            git -C "$user_repo_dir" commit -m "Migrate profile.json from v1 to v2"
            git -C "$user_repo_dir" push 2>/dev/null || echo "  (push failed -- run 'git push' manually in $(display_path "$user_repo_dir"))"
            echo "Profile migrated and committed."
        fi
    fi
}

# Version string from a git repo using tag-based scheme.
# v0.14.0              → 0.14.0       (on tag exactly)
# v0.14.0-5-gabcdef    → 0.14.0+5    (5 commits ahead of tag)
# The +N suffix indicates unreleased commits; it is never a real version.
repo_version() {
    local desc
    desc=$(git -C "$1" describe --tags --match "v*" 2>/dev/null) || true
    if [ -n "$desc" ]; then
        local base="${desc#v}"              # strip leading v
        if [[ "$base" =~ ^(.*)-([0-9]+)-g[0-9a-f]+$ ]]; then
            local tag_part="${BASH_REMATCH[1]}"   # 0.14.0
            local commits="${BASH_REMATCH[2]}"    # 5
            echo "${tag_part}+${commits}"
        else
            echo "$base"
        fi
    else
        # No tags yet — fallback to date + hash
        git -C "$1" log -1 --format='%cd (%h)' --date=short 2>/dev/null || echo "unknown"
    fi
}

# Deploy all config scripts from the repo's scripts/ directory.
# On Windows (Git Bash), calls .ps1 variants via pwsh.
# Child scripts log to LOG_FILE themselves (via tee/Add-Content), so we
# redirect stdout to /dev/null to prevent double-logging.
deploy_configs() {
    local script_dir="$1"
    local errors=0
    export AITOOLS_DEPLOY=1
    if $dry_run; then export AITOOLS_DRY_RUN=1; fi
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            if ! command -v pwsh &>/dev/null; then
                echo "  error: pwsh (PowerShell 7) not found. Install: winget install --id Microsoft.PowerShell --source winget"
                return 1
            fi
            local deploy_scripts="setup-user-claude.ps1 setup-user-mcp.ps1 setup-cursor-mcp.ps1 setup-user-cursor.ps1 setup-user-hooks.ps1"
            for script in $deploy_scripts; do
                local script_path="$script_dir/$script"
                if [ -f "$script_path" ]; then
                    # Validate PS1 syntax before executing
                    if ! pwsh -NoProfile -Command "
                        \$e = \$null
                        \$null = [System.Management.Automation.Language.Parser]::ParseFile('$(cygpath -w "$script_path")', [ref]\$null, [ref]\$e)
                        if (\$e.Count -gt 0) { exit 1 }
                    " 2>/dev/null; then
                        echo "  warning: $script has parse errors -- skipping"
                        errors=$((errors + 1))
                        continue
                    fi
                    if ! pwsh -NoProfile -ExecutionPolicy Bypass \
                        -File "$(cygpath -w "$script_path")" > /dev/null 2>> "$LOG_FILE"; then
                        echo "  error: $script failed (see $LOG_DISPLAY)"
                        errors=$((errors + 1))
                    fi
                else
                    echo "  warning: $script not found — skipping"
                fi
            done
            ;;
        *)
            local deploy_scripts="setup-user-claude.sh setup-user-mcp.sh setup-cursor-mcp.sh setup-user-cursor.sh setup-user-hooks.sh"
            for script in $deploy_scripts; do
                local script_path="$script_dir/$script"
                if [ -f "$script_path" ]; then
                    # Validate bash syntax before executing
                    if ! bash -n "$script_path" 2>/dev/null; then
                        echo "  warning: $script has syntax errors -- skipping"
                        errors=$((errors + 1))
                        continue
                    fi
                    if ! bash "$script_path" > /dev/null 2>> "$LOG_FILE"; then
                        echo "  error: $script failed (see $LOG_DISPLAY)"
                        errors=$((errors + 1))
                    fi
                else
                    echo "  warning: $script not found — skipping"
                fi
            done
            ;;
    esac
    unset AITOOLS_DEPLOY
    unset AITOOLS_DRY_RUN
    return $errors
}

# ---------------------------------------------------------------------------
# MCP server registry
# ---------------------------------------------------------------------------

# Returns URL for a known MCP server name, or empty string if unknown.
mcp_server_url() {
    case "$1" in
        vercel)  echo "https://mcp.vercel.com" ;;
        webflow) echo "https://mcp.webflow.com/mcp" ;;
        *)       echo "" ;;
    esac
}

# ---------------------------------------------------------------------------
# Usage / flags
# ---------------------------------------------------------------------------

usage() {
    cat <<'EOF'
Usage: aitools [COMMAND] [OPTIONS]

Commands:
  (none)               Sync configs: pull + rebuild + deploy all configurations
  gitpull [--patch]    Update source: pull + rebuild + deploy + changelog + version tag
                       --patch: bump patch (v0.14.0 -> v0.14.1) instead of minor
  install              Full setup: pull + rebuild + install tools + deploy configs
  mcp                  Show MCP server status for current project
  user init            Set up user repo and configure session archiving hook
  sessions list [proj] List archived sessions (optionally filter by project)
  sessions archive ID  Manually archive a session by ID (full or prefix)
  sessions move F proj Refile an archived session under a different project

Options:
  --addmcp <name...>   Enable MCP server(s) for current project (vercel, webflow)
  --dry-run            Preview what would change without writing any files
  --version, -v        Show installed and repo version
  --help, -h           Show this help

Install flags (passed through to installer):
  --skip-gh-auth       Skip GitHub CLI authentication
  --repos-path PATH    Set repos directory without prompting
  --skip-drive-detection  Skip Google Drive auto-detection
EOF
}

show_version=false
show_help=false
do_install=false
do_gitpull=false
gitpull_patch=false
do_mcp_status=false
do_user=false
user_subcmd=""
do_sessions=false
sessions_subcmd=""
sessions_args=()
addmcp_seen=false
addmcp_servers=()
dry_run=false
passthrough=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --version|-v) show_version=true; shift ;;
        --help|-h)    show_help=true; shift ;;
        --dry-run)    dry_run=true; shift ;;
        install)      do_install=true; shift ;;
        gitpull)
            do_gitpull=true; shift
            if [[ $# -gt 0 && "$1" == "--patch" ]]; then
                gitpull_patch=true; shift
            fi
            ;;
        mcp)          do_mcp_status=true; shift ;;
        user)
            do_user=true
            shift
            if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
                user_subcmd="$1"; shift
            fi
            ;;
        sessions)
            do_sessions=true
            shift
            if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
                sessions_subcmd="$1"; shift
            fi
            # Collect remaining positional args for sessions subcommands
            while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
                sessions_args+=("$1")
                shift
            done
            ;;
        --addmcp)
            addmcp_seen=true
            shift
            # Collect all following args that don't start with --
            while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
                addmcp_servers+=("$1")
                shift
            done
            ;;
        *)            passthrough+=("$1"); shift ;;
    esac
done

# Reject unknown arguments when not installing (typos like "installs", "mcpp", etc.)
if ! $do_install && [ ${#passthrough[@]} -gt 0 ]; then
    echo "error: unknown argument '${passthrough[0]}'"
    echo "Run 'aitools --help' for usage."
    return 1
fi

# Reject --addmcp with no server names
if $addmcp_seen && [ ${#addmcp_servers[@]} -eq 0 ]; then
    echo "error: --addmcp requires at least one server name (vercel, webflow)"
    return 1
fi

if $show_help; then
    usage
    return 0
fi

# ---------------------------------------------------------------------------
# Migrate config directory: ~/.config/ai-tooling/ -> ~/.aitools/
# ---------------------------------------------------------------------------

old_config_dir="$HOME/.config/ai-tooling"
new_config_dir="$HOME/.aitools"

if [ -d "$old_config_dir" ] && [ ! -d "$new_config_dir" ]; then
    mv "$old_config_dir" "$new_config_dir"
elif [ -d "$old_config_dir" ] && [ -d "$new_config_dir" ]; then
    echo "warning: both $old_config_dir and $new_config_dir exist -- using $new_config_dir"
fi

# ---------------------------------------------------------------------------
# Resolve repo path from config
# ---------------------------------------------------------------------------

config="$HOME/.aitools/config.json"
repo_path=""

if raw=$(read_config_key "$config" "repoPath") || raw=$(read_config_key "$config" "aiToolingRepoPath"); then
    repo_path=$(to_native_path "$raw")
fi
repo_path="${repo_path:-$HOME/repos/aitools}"

# ---------------------------------------------------------------------------
# --version
# ---------------------------------------------------------------------------

if $show_version; then
    echo "aitools $AITOOLS_INSTALLED_VERSION"
    if [ -d "$repo_path/.git" ]; then
        echo "  repo: $(repo_version "$repo_path") @ $(display_path "$repo_path")"
    fi
    return 0
fi

# ---------------------------------------------------------------------------
# mcp — show MCP server status
# ---------------------------------------------------------------------------

if $do_mcp_status; then
    if ! command -v node &>/dev/null; then
        echo "error: node required for mcp status"
        return 1
    fi

    node -e '
const fs = require("fs");
const path = require("path");
const os = require("os");

const home = os.homedir();
const cwd = process.cwd();

function readJson(f) {
    try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; }
}

// --- Claude Code ---
const claudeJson = readJson(path.join(home, ".claude.json"));
const claudeSettings = readJson(path.join(home, ".claude", "settings.json"));
const projectSettings = readJson(path.join(cwd, ".claude", "settings.json"));
const projectLocalSettings = readJson(path.join(cwd, ".claude", "settings.local.json"));

const claudeDeny = claudeSettings?.permissions?.deny || [];
const projectAllow = [
    ...(projectSettings?.permissions?.allow || []),
    ...(projectLocalSettings?.permissions?.allow || []),
];

console.log("MCP Server Status (" + cwd + ")\n");

if (claudeJson?.mcpServers) {
    console.log("Claude Code:");
    const servers = claudeJson.mcpServers;
    for (const [name, cfg] of Object.entries(servers)) {
        const transport = cfg.type === "http" || cfg.url ? "http" : "stdio";
        const denyPattern = "MCP(" + name + ")";
        const denied = claudeDeny.includes(denyPattern);
        const allowed = projectAllow.includes(denyPattern);
        const status = denied && !allowed ? "disabled" : "enabled";
        const pad = name.length < 16 ? " ".repeat(16 - name.length) : " ";
        console.log("  " + name + pad + status.padEnd(10) + "(user)   " + transport);
    }

    // Show project overrides if any
    const overrides = [];
    for (const rule of projectAllow) {
        const match = rule.match(/^MCP\((.+)\)$/);
        if (match) {
            const source = projectLocalSettings?.permissions?.allow?.includes(rule)
                ? ".claude/settings.local.json"
                : ".claude/settings.json";
            overrides.push({ name: match[1], source });
        }
    }
    if (overrides.length > 0) {
        console.log("  Project overrides:");
        for (const o of overrides) {
            const pad = o.name.length < 16 ? " ".repeat(16 - o.name.length) : " ";
            console.log("    " + o.name + pad + "enabled   (" + o.source + ")");
        }
    }
} else {
    console.log("Claude Code: no user-level MCP config found (~/.claude.json)");
}

console.log("");

// --- Cursor ---
const cursorJson = readJson(path.join(home, ".cursor", "mcp.json"));
const projectCursorJson = readJson(path.join(cwd, ".cursor", "mcp.json"));

if (cursorJson?.mcpServers) {
    console.log("Cursor:");
    const servers = cursorJson.mcpServers;
    for (const [name, cfg] of Object.entries(servers)) {
        const transport = cfg.url ? "http" : "stdio";
        // We cannot programmatically detect Cursor disable state from JSON alone
        const pad = name.length < 16 ? " ".repeat(16 - name.length) : " ";
        console.log("  " + name + pad + "(user)   " + transport);
    }
    if (projectCursorJson?.mcpServers) {
        console.log("  Project overrides (.cursor/mcp.json):");
        for (const [name, cfg] of Object.entries(projectCursorJson.mcpServers)) {
            const transport = cfg.url ? "http" : "stdio";
            const pad = name.length < 16 ? " ".repeat(16 - name.length) : " ";
            console.log("    " + name + pad + "enabled   " + transport);
        }
    }
} else {
    console.log("Cursor: no user-level MCP config found (~/.cursor/mcp.json)");
}
'
    return 0
fi

# ---------------------------------------------------------------------------
# --addmcp — enable MCP server(s) for current project
# ---------------------------------------------------------------------------

if [ ${#addmcp_servers[@]} -gt 0 ]; then
    # Validate all server names first
    for name in "${addmcp_servers[@]}"; do
        url=$(mcp_server_url "$name")
        if [ -z "$url" ]; then
            echo "error: unknown MCP server '$name'"
            echo "Supported servers: vercel, webflow"
            return 1
        fi
    done

    # Warn if cwd doesn't look like a project
    if [ ! -d ".git" ] && [ ! -f "package.json" ] && [ ! -f "pyproject.toml" ]; then
        echo "warning: current directory doesn't look like a project root"
        echo "  cwd: $(display_path "$(pwd)")"
        echo ""
    fi

    for name in "${addmcp_servers[@]}"; do
        url=$(mcp_server_url "$name")
        echo "Enabling $name for this project..."

        # --- Claude Code: .claude/settings.local.json (allow override) ---
        settings_local=".claude/settings.local.json"
        if command -v node &>/dev/null; then
            mkdir -p .claude
            node -e "
const fs = require('fs');
const f = process.argv[1];
let settings = {};
try { settings = JSON.parse(fs.readFileSync(f, 'utf8')); } catch (e) { if (e.code !== 'ENOENT') console.error('Warning: ' + f + ' is invalid JSON, starting with empty config'); }
if (!settings.permissions) settings.permissions = {};
if (!Array.isArray(settings.permissions.allow)) settings.permissions.allow = [];
const rule = 'MCP($name)';
if (!settings.permissions.allow.includes(rule)) {
    settings.permissions.allow.push(rule);
}
fs.writeFileSync(f, JSON.stringify(settings, null, 2) + '\n');

// Post-write validation
const _v = JSON.parse(fs.readFileSync(f, 'utf8'));
if (!_v.permissions) { console.error('Validation failed: missing permissions'); process.exit(1); }
" "$settings_local"
            echo "  Claude Code: $name enabled in $settings_local"
        else
            echo "  Claude Code: skipped (node not found)"
        fi

        # --- Cursor: try agent mcp enable, fall back to project .cursor/mcp.json ---
        cursor_done=false
        if command -v agent &>/dev/null; then
            if agent mcp enable "$name" 2>&1; then
                echo "  Cursor CLI: $name enabled (agent mcp enable)"
                cursor_done=true
            fi
        fi
        if ! $cursor_done && command -v node &>/dev/null; then
            cursor_mcp=".cursor/mcp.json"
            mkdir -p .cursor
            node -e "
const fs = require('fs');
const f = process.argv[1];
let cfg = {};
try { cfg = JSON.parse(fs.readFileSync(f, 'utf8')); } catch (e) { if (e.code !== 'ENOENT') console.error('Warning: ' + f + ' is invalid JSON, starting with empty config'); }
if (!cfg.mcpServers) cfg.mcpServers = {};
cfg.mcpServers['$name'] = { url: '$url' };
fs.writeFileSync(f, JSON.stringify(cfg, null, 2) + '\n');
" "$cursor_mcp"
            echo "  Cursor: $name added to $cursor_mcp"
        fi
        if ! $cursor_done && ! command -v node &>/dev/null; then
            echo "  Cursor: skipped (neither agent nor node found)"
        fi

        echo ""
    done

    echo "Done. MCP servers enabled for project at $(display_path "$(pwd)")"
    return 0
fi

# ---------------------------------------------------------------------------
# user — user repo management
# ---------------------------------------------------------------------------

if $do_user; then
    case "$user_subcmd" in
        init)
            # Detect GitHub username
            gh_user=""
            if command -v gh &>/dev/null; then
                # gh api may fail if not authenticated; fallback to manual input below
                gh_user=$(gh api user --jq '.login' 2>/dev/null || true)
            fi
            if [ -z "$gh_user" ]; then
                printf "GitHub username: "
                read -r gh_user < /dev/tty
            else
                echo "Detected GitHub user: $gh_user"
            fi

            if [ -z "$gh_user" ]; then
                echo "error: GitHub username required"
                return 1
            fi

            repo_name="aitools-${gh_user}"
            machine_alias=""

            # Determine repos directory from config
            repos_dir=""
            if raw=$(read_config_key "$config" "reposPath"); then
                repos_dir=$(to_native_path "$raw")
            fi
            repos_dir="${repos_dir:-$HOME/repos}"

            user_repo_dir="$repos_dir/$repo_name"

            if [ -d "$user_repo_dir/.git" ]; then
                # --- Path 1: local repo already exists ---
                echo "User repo already exists: $(display_path "$user_repo_dir")"

                # Detect machineAlias from profile.json by hostname match
                if command -v node &>/dev/null && [ -f "$user_repo_dir/profile.json" ]; then
                    machine_alias=$(node -e "
const fs = require('fs'), os = require('os');
try {
    const p = JSON.parse(fs.readFileSync(process.argv[1], 'utf8'));
    if (p.version === 2 && p.profiles) {
        const host = os.hostname().split('.')[0];
        for (const [alias, prof] of Object.entries(p.profiles)) {
            if (prof.machine && prof.machine.hostname.split('.')[0] === host) {
                console.log(alias);
                break;
            }
        }
    }
} catch {}
" "$user_repo_dir/profile.json" 2>/dev/null)
                fi

                # Detect v1 profile and offer migration
                if command -v node &>/dev/null && [ -f "$user_repo_dir/profile.json" ]; then
                    local prof_version
                    prof_version=$(node -e "
try{const p=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'));console.log(p.version||'')}catch{}
" "$user_repo_dir/profile.json" 2>/dev/null)
                    if [ "$prof_version" != "2" ]; then
                        echo "profile.json is v1 (legacy). Migrating to v2..."
                        local check_result
                        check_result=$(node "$repo_path/scripts/profile-check.js" --config "$config" 2>/dev/null)
                        if [ -n "$check_result" ]; then
                            migrate_profile_v1_to_v2 "$check_result"
                        fi
                    fi
                fi

            elif command -v gh &>/dev/null && gh repo view "$gh_user/$repo_name" --json name &>/dev/null; then
                # --- Path 2: GitHub repo exists, no local clone ---
                echo "GitHub repo exists. Cloning to $(display_path "$user_repo_dir")..."
                gh repo clone "$gh_user/$repo_name" "$user_repo_dir"

                # Detect v1 profile and offer migration
                if command -v node &>/dev/null && [ -f "$user_repo_dir/profile.json" ]; then
                    local prof_version
                    prof_version=$(node -e "
try{const p=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'));console.log(p.version||'')}catch{}
" "$user_repo_dir/profile.json" 2>/dev/null)
                    if [ "$prof_version" != "2" ]; then
                        echo "profile.json is v1 (legacy). Migrating to v2..."
                        local check_result
                        check_result=$(node "$repo_path/scripts/profile-check.js" --config "$config" 2>/dev/null)
                        if [ -n "$check_result" ]; then
                            migrate_profile_v1_to_v2 "$check_result"
                        fi
                    fi
                fi

                # Check if machine profile needs adding (v2 schema)
                if command -v node &>/dev/null && [ -f "$user_repo_dir/profile.json" ]; then
                    # Read defaults from existing profile
                    profile_defaults=$(node -e "
const fs = require('fs');
try {
    const p = JSON.parse(fs.readFileSync(process.argv[1], 'utf8'));
    const ident = p.identity || {};
    const firstProf = Object.values(p.profiles || {})[0] || {};
    console.log((ident.git && ident.git.name) || firstProf.name || '');
    console.log(firstProf.company || '');
    console.log((ident.git && ident.git.email) || '');
} catch (e) { if (e.code !== 'ENOENT') console.error('Warning: could not read profile: ' + e.message); }
" "$user_repo_dir/profile.json" 2>/dev/null)
                    default_name=$(echo "$profile_defaults" | sed -n '1p')
                    default_company=$(echo "$profile_defaults" | sed -n '2p')
                    default_email=$(echo "$profile_defaults" | sed -n '3p')

                    printf "Machine alias (e.g., laptop, workstation): "
                    read -r machine_alias < /dev/tty

                    if [ -n "$machine_alias" ]; then
                        printf "Display name [%s]: " "${default_name:-$(whoami)}"
                        read -r prof_name < /dev/tty
                        prof_name="${prof_name:-${default_name:-$(whoami)}}"

                        printf "Company [%s]: " "${default_company:-}"
                        read -r prof_company < /dev/tty
                        prof_company="${prof_company:-$default_company}"

                        shell_name=$(basename "${SHELL:-/bin/bash}")

                        node -e "
const fs = require('fs'), os = require('os');
const pf = process.argv[1], alias = process.argv[2];
try {
    const p = JSON.parse(fs.readFileSync(pf, 'utf8'));
    if (p.version === 2 && !p.profiles[alias]) {
        p.profiles[alias] = {
            name: process.argv[3],
            company: process.argv[4],
            machine: {
                hostname: os.hostname(),
                os: process.platform,
                arch: process.arch,
                shell: process.argv[5]
            }
        };
        fs.writeFileSync(pf, JSON.stringify(p, null, 2) + '\n');
        console.log('Added machine profile: ' + alias);
    } else if (p.version === 2 && p.profiles[alias]) {
        console.log('Machine profile already exists: ' + alias);
    }
} catch(e) { console.error('warning: could not update profile: ' + e.message); }
" "$user_repo_dir/profile.json" "$machine_alias" "$prof_name" "$prof_company" "$shell_name"
                    fi

                    # Set git identity from profile
                    if [ -n "$default_name" ] && [ -n "$default_email" ]; then
                        git -C "$user_repo_dir" config user.name "$default_name"
                        git -C "$user_repo_dir" config user.email "$default_email"
                    fi

                    # Commit and push if profile was modified
                    if [ -n "$(git -C "$user_repo_dir" status --porcelain)" ]; then
                        git -C "$user_repo_dir" add -A
                        git -C "$user_repo_dir" commit -m "Add machine profile: ${machine_alias}"
                        git -C "$user_repo_dir" push
                        echo "Profile updated and pushed."
                    fi
                fi

            else
                # --- Path 3: fresh setup ---
                echo "Creating user repo: $(display_path "$user_repo_dir")"
                mkdir -p "$user_repo_dir/sessions"

                # Prompt for profile info
                printf "Display name [$(whoami)]: "
                read -r prof_name < /dev/tty
                prof_name="${prof_name:-$(whoami)}"

                printf "Email: "
                read -r prof_email < /dev/tty

                printf "Company: "
                read -r prof_company < /dev/tty

                printf "Machine alias (e.g., laptop, workstation): "
                read -r machine_alias < /dev/tty

                shell_name=$(basename "${SHELL:-/bin/bash}")

                # Create v2 profile.json
                node -e "
const fs = require('fs'), os = require('os');
const profile = {
    version: 2,
    identity: {
        github: process.argv[3],
        email: process.argv[2],
        git: { name: process.argv[1], email: process.argv[2] }
    },
    profiles: {}
};
const alias = process.argv[6] || 'default';
profile.profiles[alias] = {
    name: process.argv[1],
    company: process.argv[4],
    machine: {
        hostname: os.hostname(),
        os: process.platform,
        arch: process.arch,
        shell: process.argv[5]
    }
};
fs.writeFileSync(process.argv[7], JSON.stringify(profile, null, 2) + '\n');
" "$prof_name" "$prof_email" "$gh_user" "$prof_company" "$shell_name" \
  "$machine_alias" "$user_repo_dir/profile.json"

                # Create .gitattributes
                printf '* text=auto eol=lf\n*.jsonl text eol=lf\n' > "$user_repo_dir/.gitattributes"

                # Create README
                printf '# %s\n\nPrivate user repo for session archives and profile data.\nSee [aitools](https://github.com/%s/aitools) for details.\n' \
                    "$repo_name" "$gh_user" > "$user_repo_dir/README.md"

                # Git init
                git -C "$user_repo_dir" init -b main
                git -C "$user_repo_dir" config user.name "$prof_name"
                git -C "$user_repo_dir" config user.email "$prof_email"
                git -C "$user_repo_dir" add -A
                git -C "$user_repo_dir" commit -m "Initial commit: profile and session archive structure"

                echo "User repo created."

                # Offer to create GitHub repo
                if command -v gh &>/dev/null; then
                    printf "Create private GitHub repo '%s'? [y/N]: " "$repo_name"
                    read -r create_gh < /dev/tty
                    if [[ "$create_gh" =~ ^[Yy] ]]; then
                        gh repo create "$repo_name" --private --source "$user_repo_dir" --push
                        echo "GitHub repo created and pushed."
                    fi
                fi
            fi

            # Scaffold claude/CLAUDE.md in user repo if missing
            claude_md_dest="$user_repo_dir/claude/CLAUDE.md"
            if [ ! -f "$claude_md_dest" ] && [ -f "$repo_path/shared/claude-shared.md" ]; then
                mkdir -p "$user_repo_dir/claude"
                cp "$repo_path/shared/claude-shared.md" "$claude_md_dest"
                echo "Created claude/CLAUDE.md in user repo (template with placeholders)"
                if [ -d "$user_repo_dir/.git" ]; then
                    git -C "$user_repo_dir" add claude/CLAUDE.md
                    if [ -n "$(git -C "$user_repo_dir" status --porcelain)" ]; then
                        git -C "$user_repo_dir" commit -m "Add claude/CLAUDE.md template"
                        git -C "$user_repo_dir" push 2>/dev/null || true
                    fi
                fi
            fi

            # Write userRepoPath and machineAlias to config
            if command -v node &>/dev/null; then
                node -e "
const fs = require('fs');
const f = process.argv[1];
let cfg = {};
try { cfg = JSON.parse(fs.readFileSync(f, 'utf8')); } catch (e) { if (e.code !== 'ENOENT') console.error('Warning: ' + f + ' is invalid JSON, starting with empty config'); }
cfg.userRepoPath = process.argv[2];
if (process.argv[3]) cfg.machineAlias = process.argv[3];
fs.writeFileSync(f, JSON.stringify(cfg, null, 2) + '\n');

// Post-write validation
const _v = JSON.parse(fs.readFileSync(f, 'utf8'));
const _missing = ['version','reposPath','userRepoPath'].filter(k => !(k in _v));
if (_missing.length) { console.error('Validation failed: missing ' + _missing.join(', ')); process.exit(1); }
" "$config" "$user_repo_dir" "${machine_alias:-}"
                echo "Config updated: userRepoPath = $(display_path "$user_repo_dir")"
                if [ -n "${machine_alias:-}" ]; then
                    echo "Config updated: machineAlias = $machine_alias"
                fi
            fi

            # Deploy session archive hook
            echo ""
            echo "Deploying session archive hook..."
            case "$(uname -s)" in
                MINGW*|MSYS*|CYGWIN*)
                    hook_setup="$repo_path/scripts/setup-user-hooks.ps1"
                    if [ -f "$hook_setup" ]; then
                        pwsh -NoProfile -ExecutionPolicy Bypass \
                            -File "$(cygpath -w "$hook_setup")"
                    fi
                    ;;
                *)
                    hook_setup="$repo_path/scripts/setup-user-hooks.sh"
                    if [ -f "$hook_setup" ]; then
                        bash "$hook_setup"
                    fi
                    ;;
            esac

            echo ""
            echo "Done. Sessions will be archived to $(display_path "$user_repo_dir/sessions/")"
            ;;
        "")
            echo "error: missing subcommand"
            echo "Usage: aitools user init"
            return 1
            ;;
        *)
            echo "error: unknown subcommand 'user $user_subcmd'"
            echo "Usage: aitools user init"
            return 1
            ;;
    esac
    return 0
fi

# ---------------------------------------------------------------------------
# sessions — session archive management
# ---------------------------------------------------------------------------

if $do_sessions; then
    # Resolve user repo path
    user_repo=""
    if raw=$(read_config_key "$config" "userRepoPath"); then
        user_repo=$(to_native_path "$raw")
    fi
    if [ -z "$user_repo" ] || [ ! -d "$user_repo" ]; then
        echo "error: user repo not configured. Run 'aitools user init' first."
        return 1
    fi
    sessions_dir="$user_repo/sessions"

    case "$sessions_subcmd" in
        list)
            filter="${sessions_args[0]:-}"
            if [ ! -d "$sessions_dir" ]; then
                echo "No sessions archived yet."
                return 0
            fi
            found=false
            # Use a subshell+pipeline to iterate reliably
            while IFS= read -r file; do
                [ -z "$file" ] && continue
                rel="${file#"$sessions_dir/"}"
                project="${rel%%/*}"
                if [ -n "$filter" ] && [ "$project" != "$filter" ]; then
                    continue
                fi
                size=$(du -h "$file" | cut -f1 | tr -d ' ')
                printf '%s  (%s)\n' "$rel" "$size"
                found=true
            # sessions_dir may not exist; suppress find errors, checked via $found
            done < <(find "$sessions_dir" -name "*.jsonl" -type f 2>/dev/null | sort)
            if ! $found; then
                if [ -n "$filter" ]; then
                    echo "No sessions found for project '$filter'."
                else
                    echo "No sessions archived yet."
                fi
            fi
            ;;
        archive)
            session_id="${sessions_args[0]:-}"
            if [ -z "$session_id" ]; then
                echo "error: session ID required"
                echo "Usage: aitools sessions archive <session-id>"
                return 1
            fi

            # Search for matching session in ~/.claude/projects/
            claude_projects="$HOME/.claude/projects"
            if [ ! -d "$claude_projects" ]; then
                echo "error: no Claude Code sessions found at $claude_projects"
                return 1
            fi

            # Find matching JSONL file(s)
            matches=()
            while IFS= read -r f; do
                matches+=("$f")
            # claude_projects dir may not exist; suppress find errors, checked via matches count
            done < <(find "$claude_projects" -name "${session_id}*.jsonl" -type f 2>/dev/null)

            if [ ${#matches[@]} -eq 0 ]; then
                echo "error: no session found matching '$session_id'"
                echo "Hint: check 'ls ~/.claude/projects/*/' for available sessions"
                return 1
            fi

            if [ ${#matches[@]} -gt 1 ]; then
                echo "Multiple sessions match '$session_id':"
                for m in "${matches[@]}"; do
                    echo "  $(basename "$m" .jsonl)"
                done
                echo "Provide a longer prefix to disambiguate."
                return 1
            fi

            transcript="${matches[0]}"
            full_id=$(basename "$transcript" .jsonl)

            # Derive project name from CWD recorded in the JSONL transcript
            # Uses node (already required by other aitools commands)
            session_cwd=$(node -e "
const fs = require('fs'), readline = require('readline');
const rl = readline.createInterface({ input: fs.createReadStream(process.argv[1]) });
rl.on('line', line => {
    try {
        const d = JSON.parse(line);
        if (d.cwd) { process.stdout.write(d.cwd); rl.close(); }
    } catch {}
});
" "$transcript" 2>/dev/null)

            if [ -n "$session_cwd" ]; then
                # Use same derivation logic as the hook
                cwd_repo=$(cd "$session_cwd" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || echo "")
                if [ -n "$cwd_repo" ]; then
                    project=$(basename "$cwd_repo")
                else
                    project=$(basename "$session_cwd" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9-]/-/g')
                fi
            else
                # Last resort: basename of the Claude projects directory
                # Lossy for project names with hyphens (e.g., ai-tooling → tooling)
                project_dir=$(basename "$(dirname "$transcript")")
                project=$(echo "$project_dir" | rev | cut -d'-' -f1 | rev)
            fi

            # Derive date
            if [ "$(uname -s)" = "Darwin" ]; then
                archive_date=$(stat -f "%SB" -t "%Y-%m-%d" "$transcript" 2>/dev/null || date -u +%Y-%m-%d)
            else
                archive_date=$(date -u +%Y-%m-%d)
            fi

            prefix=$(echo "$full_id" | cut -c1-8)
            dest_dir="$sessions_dir/$project"
            dest_file="$dest_dir/${archive_date}_${prefix}.jsonl"

            if [ -f "$dest_file" ]; then
                echo "Already archived: ${dest_file#"$user_repo/"}"
                return 0
            fi

            mkdir -p "$dest_dir"
            cp "$transcript" "$dest_file"
            echo "Archived: ${dest_file#"$user_repo/"}"
            ;;
        move)
            src="${sessions_args[0]:-}"
            dest_project="${sessions_args[1]:-}"
            if [ -z "$src" ] || [ -z "$dest_project" ]; then
                echo "error: source file and destination project required"
                echo "Usage: aitools sessions move <file> <project>"
                return 1
            fi

            # Resolve source path (relative to sessions dir or absolute)
            if [[ "$src" = /* ]]; then
                src_file="$src"
            else
                src_file="$sessions_dir/$src"
            fi

            if [ ! -f "$src_file" ]; then
                echo "error: session file not found: $src"
                return 1
            fi

            dest_dir="$sessions_dir/$dest_project"
            dest_file="$dest_dir/$(basename "$src_file")"
            mkdir -p "$dest_dir"
            mv "$src_file" "$dest_file"
            echo "Moved: $(basename "$src_file") -> $dest_project/"

            # Clean up empty source directory
            old_dir=$(dirname "$src_file")
            if [ -d "$old_dir" ] && [ -z "$(ls -A "$old_dir" 2>/dev/null)" ]; then
                rmdir "$old_dir"
            fi
            ;;
        "")
            echo "error: missing subcommand"
            echo "Usage: aitools sessions list|archive|move"
            return 1
            ;;
        *)
            echo "error: unknown subcommand 'sessions $sessions_subcmd'"
            echo "Usage: aitools sessions list|archive|move"
            return 1
            ;;
    esac
    return 0
fi

# ---------------------------------------------------------------------------
# Verify repo exists (or clone if gitpull)
# ---------------------------------------------------------------------------

if [ ! -d "$repo_path/.git" ]; then
    if $do_gitpull; then
        echo "Repo not found — cloning..."
        if command -v gh &>/dev/null; then
            gh repo clone nobul-jose/aitools "$repo_path" || {
                echo "error: clone failed"
                return 1
            }
        else
            echo "error: gh CLI not found. Install GitHub CLI first."
            return 1
        fi
    else
        echo "error: aitools repo not found at $(display_path "$repo_path")"
        echo "Run 'aitools gitpull' to clone the repo first."
        return 1
    fi
fi

# ---------------------------------------------------------------------------
# Run update (pull + rebuild + deploy/install)
# ---------------------------------------------------------------------------

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/aitools"
[ "$(uname -s)" = "Darwin" ] && LOG_DIR="$HOME/Library/Logs/aitools"
LOG_FILE="$LOG_DIR/deploy.log"
mkdir -p "$LOG_DIR"

# Display-friendly path for user-facing messages
LOG_DISPLAY=$(display_path "$LOG_FILE")

export AITOOLS_RUN_ID=$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')

echo "aitools $AITOOLS_INSTALLED_VERSION"
echo ""

if $do_install; then
    STEPS=3
elif $do_gitpull; then
    STEPS=4
else
    # no-args: quiet pull + rebuild + deploy
    STEPS=3
fi

# [1/N] Pull latest
if $do_gitpull; then
    echo "[1/$STEPS] Pulling latest..."
    pulled_updates=false
    if pull_out=$(cd "$repo_path" && git pull --tags origin main 2>&1); then
        if echo "$pull_out" | grep -q "Already up to date"; then
            echo "  Already up to date."
        else
            pulled_updates=true
            echo "  Updated."
        fi
    else
        echo "  error: git pull failed" >&2
        echo "$pull_out" >&2
        return 1
    fi
else
    # no-args and install: quiet pull (warn on failure, continue from local)
    echo "[1/$STEPS] Pulling latest..."
    pulled_updates=false
    # Reset generated deploy/ files before pull (may have line-ending diffs)
    git -C "$repo_path" checkout -- deploy/ 2>/dev/null || true
    if pull_out=$(cd "$repo_path" && git pull origin main 2>&1); then
        if echo "$pull_out" | grep -q "Already up to date"; then
            echo "  Already up to date."
        else
            pulled_updates=true
            echo "  Updated."
        fi
    else
        if echo "$pull_out" | grep -qiE "could not resolve|unable to access|connection refused|connection timed out|no route to host"; then
            echo "  Could not reach remote — deploying from local checkout."
        else
            echo "  warning: git pull failed — deploying from local checkout." >&2
            echo "$pull_out" | head -3 | sed 's/^/    /' >&2
        fi
    fi
fi

# Pull user repo (quiet, non-blocking — stale local data is better than failing)
if raw=$(read_config_key "$config" "userRepoPath"); then
    user_repo_path=$(to_native_path "$raw")
    if [ -d "$user_repo_path/.git" ]; then
        if ! git -C "$user_repo_path" pull --ff-only --quiet 2>/dev/null; then
            echo "  warning: user repo pull failed — using local copy." >&2
        fi
    fi
fi

# [2/N] Rebuild deploy scripts
echo "[2/$STEPS] Rebuilding deploy scripts..."
if bash "$repo_path/scripts/build-deploy.sh" >> "$LOG_FILE" 2>&1; then
    echo "  Done."
else
    echo "  error: build failed (see $LOG_DISPLAY)" >&2
    return 1
fi

if $do_install; then
    # --- install: pull + rebuild + run installer (includes deploy) ---
    echo "[3/$STEPS] Running installer..."
    echo ""
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            # Windows: forward to PowerShell installer with translated flags
            ps_args=()
            local i=0
            while [ $i -lt ${#passthrough[@]} ]; do
                case "${passthrough[$i]}" in
                    --skip-gh-auth)         ps_args+=("-SkipGhAuth") ;;
                    --skip-drive-detection) ps_args+=("-SkipDriveDetection") ;;
                    --repos-path)
                        ps_args+=("-ReposPath")
                        i=$((i + 1))
                        ps_args+=("$(cygpath -w "${passthrough[$i]}")")
                        ;;
                    *) ps_args+=("${passthrough[$i]}") ;;
                esac
                i=$((i + 1))
            done
            pwsh -NoProfile -ExecutionPolicy Bypass \
                -File "$(cygpath -w "$repo_path/scripts/aitools-install.ps1")" \
                "${ps_args[@]}"
            ;;
        *)
            bash "$repo_path/scripts/aitools-install.sh" "${passthrough[@]}" < /dev/null
            ;;
    esac
    installer_rc=$?
    echo ""
    if [ $installer_rc -eq 0 ]; then
        echo "All up to date. ($(repo_version "$repo_path"))"
        # Session archive hint (after final status line)
        if ! read_config_key "$config" "userRepoPath" >/dev/null 2>&1; then
            printf '\033[33mhint: To archive sessions across machines, run '\''aitools user init'\''.\033[0m\n'
        fi
        check_profile interactive
    else
        echo "Completed with errors (see $(display_path "$LOG_FILE"))."
    fi

elif $do_gitpull; then
    # --- gitpull: pull + rebuild + deploy + changelog + version tag ---
    echo "[3/$STEPS] Deploying configurations..."
    deploy_configs "$repo_path/scripts"
    deploy_rc=$?
    if [ $deploy_rc -eq 0 ]; then
        echo "  Done."
    else
        echo "  Completed with $deploy_rc error(s)."
    fi

    echo "[4/$STEPS] Tagging version..."
    # Skip if HEAD already has a tag (e.g., re-running gitpull without new commits)
    if git -C "$repo_path" describe --tags --match "v*" --exact-match HEAD >/dev/null 2>&1; then
        existing=$(git -C "$repo_path" describe --tags --match "v*" --exact-match HEAD 2>/dev/null)
        echo "  HEAD already tagged ($existing) — skipping"
        tag="$existing"
    else
        latest_tag=$(git -C "$repo_path" describe --tags --match "v*" --abbrev=0 2>/dev/null || echo "v0.0.0")
        if $gitpull_patch; then
            # Patch bump: v0.14.0 → v0.14.1
            local major minor patch
            IFS='.' read -r major minor patch <<< "${latest_tag#v}"
            patch=$((patch + 1))
            tag="v${major}.${minor}.${patch}"
        else
            # Minor bump: v0.14.0 → v0.15.0 (existing default)
            latest_minor=${latest_tag#v0.}
            latest_minor=${latest_minor%%.*}
            next_minor=$((latest_minor + 1))
            tag="v0.${next_minor}.0"
        fi
        # Release notes gate: require a matching entry before tagging
        tag_short="${tag%%.0}"  # v0.18.0 -> v0.18, v0.18.1 stays v0.18.1
        if ! grep -q "^## ${tag} \|^## ${tag_short} " "$repo_path/RELEASE_NOTES.md" 2>/dev/null; then
            printf '\033[33m  RELEASE_NOTES.md has no entry for %s -- skipping tag.\033[0m\n' "$tag"
            echo "  Add a '## ${tag} -- Title ($(date -u +%Y-%m-%d))' section first."
            tag="(skipped)"
        else
            git -C "$repo_path" tag "$tag"
            if git -C "$repo_path" push origin "$tag" 2>/dev/null; then
                echo "  Tagged $tag"
            else
                echo "  Tagged $tag (local only -- push failed)"
            fi
        fi
    fi

    echo ""
    if $pulled_updates; then
        echo "Updated and deployed. ($tag)"
        # Show date-formatted changelog (no hashes)
        cd "$repo_path" && git log --format='  %ad  %s' --date=short ORIG_HEAD..HEAD 2>/dev/null
    else
        echo "Deployed. ($tag)"
    fi

else
    # --- no-args: quiet pull + rebuild + deploy ---
    echo "[3/$STEPS] Deploying configurations..."
    deploy_configs "$repo_path/scripts"
    deploy_rc=$?
    if [ $deploy_rc -eq 0 ]; then
        echo "  Done."
    else
        echo "  Completed with $deploy_rc error(s)."
    fi

    echo ""
    echo "Configs deployed. ($(repo_version "$repo_path"))"

    check_profile interactive

    # Session archive hint (after final status line)
    settings_file="$HOME/.claude/settings.json"
    hook_installed=false
    if [ -f "$settings_file" ] && grep -q "session-archive.sh" "$settings_file" 2>/dev/null; then
        hook_installed=true
    fi
    if [ "$hook_installed" = true ]; then
        if ! read_config_key "$config" "userRepoPath" >/dev/null 2>&1; then
            printf '\033[33mWARNING: session archive hook installed but inactive -- userRepoPath not configured. Run '\''aitools user init'\''.\033[0m\n'
        fi
    else
        printf '\033[33mhint: session archive hook not installed. Run '\''aitools user init'\'' to set up.\033[0m\n'
    fi
fi

# Self-update: bake version into installed copy AFTER installer
# (installer Step 6 copies the source file, so we must re-stamp after)
if [ -f "$repo_path/scripts/aitools" ]; then
    new_version=$(repo_version "$repo_path")

    # Validate bash syntax before overwriting installed copy
    if bash -n "$repo_path/scripts/aitools" 2>/dev/null; then
        sed "s/^AITOOLS_INSTALLED_VERSION=.*/AITOOLS_INSTALLED_VERSION=\"$new_version\"/" \
            "$repo_path/scripts/aitools" > "$HOME/.local/bin/aitools"
        chmod +x "$HOME/.local/bin/aitools"
    else
        echo "  warning: skipping bash self-update (new aitools has syntax errors)"
    fi

    # On Windows, also self-update aitools.ps1 (validate with current PS version first)
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            if [ -f "$repo_path/scripts/aitools.ps1" ]; then
                if pwsh -NoProfile -Command "
                    \$e = \$null
                    [System.Management.Automation.Language.Parser]::ParseFile('$(cygpath -w "$repo_path/scripts/aitools.ps1")', [ref]\$null, [ref]\$e)
                    if (\$e.Count -gt 0) { exit 1 }
                " 2>/dev/null; then
                    sed 's/^\$AITOOLS_INSTALLED_VERSION = ".*"/$AITOOLS_INSTALLED_VERSION = "'"$new_version"'"/' \
                        "$repo_path/scripts/aitools.ps1" > "$HOME/.local/bin/aitools.ps1"
                else
                    echo "  warning: skipping PS1 self-update (parse errors on this PowerShell version)"
                fi
            fi
            ;;
    esac
fi

unset AITOOLS_RUN_ID

}

main "$@"; exit
