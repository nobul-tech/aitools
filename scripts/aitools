#!/usr/bin/env bash
# aitools -- pull latest aitools scaffolding and manage dev tools
# Installed to ~/.local/bin/ by scripts/aitools-install.{sh,ps1}
#
# The entire script is wrapped in main() so bash reads it fully into memory
# before executing. This prevents corruption when the installer overwrites
# this file on disk during Step 6.

AITOOLS_INSTALLED_VERSION="dev"

main() {

# ---------------------------------------------------------------------------
# Ensure Homebrew tools (node, etc.) are on PATH
# ---------------------------------------------------------------------------
# Interactive shells get this from ~/.zprofile, but non-interactive invocations
# (Claude Code hooks, MDM, `!` shells, scripts) do NOT source profile files. The
# config/JSON setup scripts shell out to `node`, so without this they fail with
# "node required for JSON manipulation". Mirrors bootstrap.sh.
if [ "$(uname -s)" = "Darwin" ] && ! command -v brew >/dev/null 2>&1; then
    if [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -x /usr/local/bin/brew ]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
fi

# ---------------------------------------------------------------------------
# Bootstrap helpers -- needed to find aitools-lib.sh (repoPath in config.json).
# Everything else (logging, display_path, write_summary, ...) comes from the lib,
# which is sourced as soon as repoPath is known (see "Load aitools-lib" below).
# The lib defines an identical read_config_key, which replaces this one.
# ---------------------------------------------------------------------------

# Read a top-level string value from a JSON config file.
# Handles UTF-8 BOM (PowerShell 5.x writes one) and JSON-escaped backslashes.
read_config_key() {
    local file="$1" key="$2"
    [ -f "$file" ] || return 1
    local val
    val=$(tr -d '\357\273\277' < "$file" \
        | grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" \
        | head -1 \
        | cut -d'"' -f4)
    [ -n "$val" ] || return 1
    # Unescape JSON backslashes: \\ -> \
    printf '%b' "$val"
}

# Convert a Windows path to Unix-style for Git Bash / MSYS2. No-op elsewhere.
to_native_path() {
    if command -v cygpath &>/dev/null; then
        cygpath -u "$1"
    else
        printf '%s' "$1"
    fi
}

# Check profile.json for issues and optionally prompt for fixes.
# Usage: check_profile <warn|interactive>
# Requires: node, $repo_path, $config
check_profile() {
    local mode="${1:-warn}"
    command -v node &>/dev/null || return 0
    [ -d "$repo_path" ] || return 0

    local check_script="$repo_path/scripts/profile-check.js"
    [ -f "$check_script" ] || return 0

    local result
    result=$(node "$check_script" --config "$config" 2>/dev/null) || return 0

    local status
    status=$(printf '%s' "$result" | node -e "
        let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
            try{console.log(JSON.parse(d).status)}catch{console.log('error')}
        })
    " 2>/dev/null)

    case "$status" in
        ok|unconfigured) return 0 ;;
        error)
            local msg
            msg=$(printf '%s' "$result" | node -e "
                let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
                    try{const r=JSON.parse(d);console.log((r.issues[0]&&r.issues[0].message)||'profile.json has issues')}catch{console.log('profile.json has issues')}
                })
            " 2>/dev/null)
            printf '\033[33mprofile: %s\033[0m\n' "$msg"
            ;;
        warn)
            # Print each issue as a warning
            printf '%s' "$result" | node -e "
                let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
                    try{const r=JSON.parse(d);r.issues.forEach(i=>console.log(i.message))}catch(e){console.error('profile parse error: '+e.message)}
                })
            " 2>/dev/null | while IFS= read -r line; do
                printf '\033[33mprofile: %s\033[0m\n' "$line"
            done
            if [ "$mode" = "interactive" ] && [ -t 0 ]; then
                printf '\033[33mRun '\''aitools user init'\'' to fix.\033[0m\n'
            fi
            ;;
        migrate)
            printf '\033[33mprofile: profile.json is v1 (legacy). Migration to v2 recommended.\033[0m\n'
            if [ "$mode" = "interactive" ] && ui_can_ask; then
                local answer="" ppath=""
                printf "Migrate profile.json to v2 now? [y/N]: " > /dev/tty
                read_tty_choice answer "no"
                if [[ "$answer" =~ ^[Yy] ]]; then
                    ppath=$(printf '%s' "$result" | node -e "
                        let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
                            try{console.log(JSON.parse(d).profilePath||'')}catch(e){console.error('profile-check output unreadable: '+e.message)}
                        })
                    ") || ppath=""  # unreadable output: the -n test below skips the migration (node printed why)
                    if [ -n "$ppath" ]; then migrate_profile_v1_to_v2 "$(dirname "$ppath")"; fi
                fi
            fi
            ;;
    esac
}

# ---------------------------------------------------------------------------
# aitools user init: this machine's profile (reference/user-repo.md
# "Registration"; re-key design S3-M3-Register-keydesign.md sections b, c, f, g;
# PR #86 batch 5). Machine profiles are keyed by this machine's id
# (profiles.<machine id, lower-cased>); the human-readable name is the profile's
# alias field. The native resolver (aitools-profile) decides which profile this
# machine is, writes only this machine's key (register, to a temp file that is
# validated, backed up and moved here) and re-keys alias-keyed revision 2.1
# profiles (migrate). Only profile.json is committed and pushed (N-Q2). Menus,
# prompts, summary rows and exit codes are identical in aitools.ps1
# (interactive-menus.md). Without a terminal, with --force or AITOOLS_FORCE=1,
# nothing prompts: the default applies, or the step reports ERROR + ACTION.
# ---------------------------------------------------------------------------

# Decision 2 (PENDING with the commander -- S3-M3Lead plan section 2 item 2; re-key
# design (b) step 4L): config.json's cached machineAlias names an alias-keyed
# profile without machine.id (resolver via=alias). 0 = today's behaviour: ask on a
# terminal (that profile suggested), ERROR + ACTION without one. 1 = claim that
# profile for this machine without asking. Flipping the decision is this one line
# (and $script:RegisterCachedAliasSilently in aitools.ps1).
AITOOLS_REGISTER_CACHED_ALIAS_SILENTLY=0

# ui_lc TEXT -- ASCII lower case (the resolver's rule for profile keys)
ui_lc() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

# ui_can_ask -- 0 when user init may prompt: a terminal, and neither --force nor
# AITOOLS_FORCE=1 (interactive-menus.md "Non-interactive fallback")
ui_can_ask() {
    if $force || [ "${AITOOLS_FORCE:-}" = "1" ]; then return 1; fi
    tty_interactive
}

# ui_machine_shell -- the machine.shell value (Review3 #82 minor 6): one stable
# value per platform, so the two Windows entry points (Git Bash aitools and
# aitools.ps1) do not rewrite it on alternate runs. Windows: pwsh, the managed
# shell there, whichever entry point runs. macOS/Linux: the login shell ($SHELL).
ui_machine_shell() {
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) printf 'pwsh' ;;
        *) basename "${SHELL:-/bin/bash}" ;;
    esac
}

# ui_log_lines PREFIX TEXT -- each non-empty line of TEXT as a detail line
ui_log_lines() {
    local l
    while IFS= read -r l; do
        l="${l//$'\r'/}"
        if [ -n "$l" ]; then log_detail "$1$l"; fi
    done <<< "$2"
}

# ui_action TEXT -- one ACTION row TEXT per run (show_summary does not dedupe
# ACTIONs). The caller's log_warn / log_error line carries the same instruction.
ui_action() {
    if [ -n "${AITOOLS_SUMMARY_FILE:-}" ] && [ -f "$AITOOLS_SUMMARY_FILE" ] \
        && grep -qxF -- "ACTION||$1" "$AITOOLS_SUMMARY_FILE"; then
        log_detail "ACTION already in the run summary: $1"
        return 0
    fi
    write_summary ACTION "" "$1"
}

# ui_rm_tmp FILE -- remove a temp file; a failure is a warning, never silent
ui_rm_tmp() {
    if [ -e "$1" ] && ! rm -f "$1"; then log_warn "could not remove $(display_path "$1")"; fi
    return 0
}

# ui_profile_run ARGS... -- run the resolver through the lib runner
# (_aitlib_profile_run in aitools-lib.sh: aitools-profile.sh, or under Git Bash on
# Windows aitools-profile.ps1 through pwsh) and copy its results right after the
# call (the lib's result-global contract): UI_PROF_OUT (key<TAB>value lines, CR
# stripped; for hostname the bare value) and UI_PROF_RC (0 ok, 1 nothing found,
# 2 error -- also no resolver, a crash, or an exit 0/1 without result lines --
# 3 refused, 4 alias in use). The resolver's own log lines become detail lines.
# AITOOLS_PROFILE_SH / AITOOLS_PROFILE_PS1 override the resolver, as for every lib
# caller (register and migrate then write through it). Returns 0.
ui_profile_run() {
    # Return 1 = no resolver: AITLIB_PROFILE_RC is then 2 with an "error" line
    # naming it, which every caller reads (UI_PROF_RC, ui_lines): the result check
    _aitlib_profile_run "$@" || :
    UI_PROF_OUT="$AITLIB_PROFILE_OUT"; UI_PROF_RC="$AITLIB_PROFILE_RC"
    return 0
}

# ui_tag KEY -- the value of the first KEY line of the last resolver call
ui_tag() {
    local k v
    while IFS=$'\t' read -r k v; do
        if [ "$k" = "$1" ]; then printf '%s' "$v"; return 0; fi
    done <<< "$UI_PROF_OUT"
    return 0
}
# ui_lines KIND -- every warn or error value of the last resolver call, one per line
ui_lines() {
    local k v
    while IFS=$'\t' read -r k v; do
        if [ "$k" = "$1" ]; then printf '%s\n' "$v"; fi
    done <<< "$UI_PROF_OUT"
    return 0
}
# ui_first_error -- the first error line of the last resolver call ("" when none)
ui_first_error() { ui_lines error | perl -ne 'print, exit if /\S/'; }

# ui_handled MSG -- 0 when MSG is a resolver warning or error that user init
# resolves itself (it registers, claims, re-keys or refreshes the profile); those
# are logged at info, every other one at its own level (the resolver's
# library-style contract: it returns diagnostics, the caller logs them -- re-key
# design (j) finding 1, Review3 #82 M2)
ui_handled() {
    case "$1" in
        *"keyed by alias -- run: aitools-profile migrate"*|*"has no machine.id -- run: aitools user init"*) return 0 ;;
        *"has no machine.id -- left as is"*|*"matched by hostname only"*|*"no profile matches this machine"*) return 0 ;;
        *"profile.json has no machine profiles"*|*"was registered with hostname"*) return 0 ;;
    esac
    return 1
}

# ui_relay_warnings -- log the last resolver call's warn lines (handled: info)
ui_relay_warnings() {
    local w
    while IFS= read -r w; do
        if [ -z "$w" ]; then continue; fi
        if ui_handled "$w"; then log "machine profile: $w (user init handles this)"
        else log_warn "machine profile: $w"; fi
    done <<< "$(ui_lines warn)"
}

# ui_push_action DIR -- the ACTION for a commit or push the resolver reported as
# failed (its warning, logged by ui_relay_warnings, says why)
ui_push_action() {
    local d
    d=$(display_path "$1")
    if [ "$(ui_tag committed)" != "true" ]; then ui_action "commit and push profile.json in $d"
    elif grep -q "pull --rebase" <<< "$(ui_lines warn)"; then ui_action "git pull --rebase, then git push in $d"
    else ui_action "run git push in $d"; fi
}

# ui_push DIR -- push DIR. Without a terminal git may not prompt
# (GIT_TERMINAL_PROMPT=0; ssh BatchMode unless GIT_SSH_COMMAND is set). A push the
# remote rejected (it has newer commits) is told to pull --rebase first (Review3
# #82 minor 4). Returns 0 pushed, 1 not pushed (log_warn + ACTION).
ui_push() {
    local dir="$1" out rc=0 d
    d=$(display_path "$dir")
    if ui_can_ask; then
        out=$(git -C "$dir" push 2>&1) || rc=$?
    else
        out=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}" git -C "$dir" push 2>&1) || rc=$?
    fi
    ui_log_lines "git push: " "$out"
    if [ "$rc" -eq 0 ]; then return 0; fi
    case "$out" in
        *rejected*|*non-fast-forward*|*"fetch first"*)
            log_warn "dotprofile push rejected (exit $rc): the remote has newer commits -- run git pull --rebase, then git push in $d"
            ui_action "git pull --rebase, then git push in $d" ;;
        *)
            log_warn "dotprofile push failed (exit $rc) -- run git push in $d"
            ui_action "run git push in $d" ;;
    esac
    return 1
}

# ui_commit DIR MESSAGE FILE... -- commit only FILE... in DIR, then push (N-Q2).
# No git identity on this machine yet: commits as the profile's identity.git (the
# person the dotprofile belongs to). Returns 0 committed and pushed, 1 commit
# failed, 2 committed but not pushed; each failure is a log_warn + one ACTION.
ui_commit() {
    local dir="$1" msg="$2"; shift 2
    local out rc=0 who=() gname="" gmail="" cur_name="" cur_mail="" d
    d=$(display_path "$dir")
    cur_name=$(git -C "$dir" config user.name) || cur_name=""  # unset = exit 1; handled by the -z test
    cur_mail=$(git -C "$dir" config user.email) || cur_mail=""  # unset = exit 1; handled by the -z test
    if { [ -z "$cur_name" ] || [ -z "$cur_mail" ]; } && [ -f "$dir/profile.json" ]; then
        gname=$(perl "$repo_path/scripts/aitools-json.pl" get "$dir/profile.json" identity git name) || gname=""  # absent: git reports the missing identity below
        gmail=$(perl "$repo_path/scripts/aitools-json.pl" get "$dir/profile.json" identity git email) || gmail=""  # absent: git reports the missing identity below
        if [ -n "$gname" ] && [ -n "$gmail" ]; then who=(-c "user.name=$gname" -c "user.email=$gmail"); fi
    fi
    out=$(git -C "$dir" add -- "$@" 2>&1) || rc=$?
    if [ "$rc" -eq 0 ]; then out=$(git -C "$dir" ${who[@]+"${who[@]}"} commit -m "$msg" -- "$@" 2>&1) || rc=$?; fi
    ui_log_lines "git commit: " "$out"
    if [ "$rc" -ne 0 ]; then
        log_warn "dotprofile commit failed (exit $rc) -- commit and push $* in $d by hand"
        ui_action "commit and push $* in $d"
        return 1
    fi
    if ! ui_push "$dir"; then return 2; fi
    log_ok "machine profile: $* committed and pushed ($msg)"
    return 0
}

# ui_profile_dirty DIR -- 0 when DIR/profile.json is tracked and has uncommitted
# changes (Review3 #82 minor 5: a hand edit must not be committed under this
# run's message); 1 when clean, untracked, or DIR is not a git repository
ui_profile_dirty() {
    local dir="$1" rc=0
    git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1  # not a repository: nothing is committed there
    git -C "$dir" ls-files --error-unmatch -- profile.json >/dev/null 2>&1 || return 1  # untracked: no committed version to protect
    git -C "$dir" diff --quiet -- profile.json || rc=$?
    if [ "$rc" -eq 0 ]; then git -C "$dir" diff --cached --quiet -- profile.json || rc=$?; fi
    [ "$rc" -ne 0 ]
}

# ui_entries PF THIS_ID -- the profiles in PF, in file order: UI_E_KEY,
# UI_E_ALIAS (alias field, else the key) and UI_E_OWNER (this | other |
# unregistered: whose profile it is, by machine.id / machine.environment -- the
# resolver's owner rule)
ui_entries() {
    local pf="$1" js="$repo_path/scripts/aitools-json.pl" tid keys k kl t al mid menv owner
    UI_E_KEY=(); UI_E_ALIAS=(); UI_E_OWNER=()
    tid=$(ui_lc "$2")
    keys=$(perl "$js" keys "$pf" profiles) || keys=""  # no profiles object = no entries (the resolver reported why)
    while IFS= read -r k; do
        if [ -z "$k" ]; then continue; fi
        t=$(perl "$js" type "$pf" profiles "$k") || t=""  # null = not a profile
        if [ "$t" != "object" ]; then continue; fi
        al=$(perl "$js" get "$pf" profiles "$k" alias) || al=""  # absent: the key is the name
        mid=$(perl "$js" get "$pf" profiles "$k" machine id) || mid=""  # absent: no machine registered it
        menv=$(perl "$js" get "$pf" profiles "$k" machine environment) || menv=""  # absent: not an environment profile
        kl=$(ui_lc "$k")
        case "$kl" in
            environment:*) if [ "$kl" = "environment:$AITOOLS_ENVIRONMENT" ]; then owner=this; else owner=other; fi ;;
            *)
                if [ -n "$menv" ]; then
                    if [ "$menv" = "$AITOOLS_ENVIRONMENT" ]; then owner=this; else owner=other; fi
                elif [ -z "$mid" ]; then
                    if [ -n "$tid" ] && [ "$kl" = "$tid" ]; then owner=this; else owner=unregistered; fi
                elif [ -z "$tid" ]; then owner=unknown  # this machine's id is unknown (review n4)
                elif [ "$(ui_lc "$mid")" = "$tid" ]; then owner=this
                else owner=other; fi ;;
        esac
        UI_E_KEY+=("$k"); UI_E_ALIAS+=("${al:-$k}"); UI_E_OWNER+=("$owner")
    done <<< "$keys"
}

# ui_choose PF SUGGESTED_KEY THIS_ID -- ask which profile this machine is. Every
# profile is listed in file order: one that belongs to no machine is numbered
# (picking it claims it: register --claim KEY, Resolver Q2); one registered to
# another machine is shown as "[-] ... (registered to another machine)" and cannot
# be picked; the profile the resolver suggests (cached alias, hostname match) is
# marked "(suggested)". Sets UI_CHOICE_KIND (claim | new) and UI_CHOICE (the key to
# claim, or the new alias). Returns 0 chosen; 1 no terminal to ask (log_error +
# ERROR row + ACTION); 2 skipped at the prompt (log_warn; the caller writes the row).
ui_choose() {
    local pf="$1" sug="$2" i n=0 nums=() label choice
    UI_CHOICE_KIND=""; UI_CHOICE=""
    if ! ui_can_ask; then
        log_error "machine profile: this machine has no profile and there is no terminal to ask -- run: aitools user init --alias <name> (or aitools user init on a terminal)"
        write_summary ERROR "machine profile" "not registered (no terminal)"
        ui_action "Run: aitools user init --alias <name> (or on a terminal)"
        return 1
    fi
    ui_entries "$pf" "$3"
    printf 'Which profile is this machine?\n' > /dev/tty
    i=0
    while [ "$i" -lt "${#UI_E_KEY[@]}" ]; do
        label="${UI_E_ALIAS[i]}"
        case "${UI_E_OWNER[i]}" in
            unregistered)
                n=$((n + 1)); nums+=("$i")
                if [ "${UI_E_KEY[i]}" = "$sug" ]; then label="$label (suggested)"; fi
                printf '  [%d] %s\n' "$n" "$label" > /dev/tty ;;
            other)
                if [ "${UI_E_KEY[i]}" = "$sug" ]; then label="$label (suggested, registered to another machine)"
                else label="$label (registered to another machine)"; fi
                printf '  [-] %s\n' "$label" > /dev/tty ;;
            unknown)
                printf '  [-] %s (owner unknown: this machine'\''s id cannot be detected)\n' "$label" > /dev/tty ;;
        esac
        i=$((i + 1))
    done
    printf '  [n] new profile for this machine\n  [s] skip\nChoice: ' > /dev/tty
    read_tty_choice choice "skip"
    case "$choice" in
        [sS]|"")
            log_warn "machine profile: registration skipped -- deploys will report no machine match"
            return 2 ;;
        [nN])
            printf 'New alias (e.g., laptop, workstation): ' > /dev/tty
            read_tty_choice UI_CHOICE "skip"
            if [ -z "$UI_CHOICE" ]; then
                log_warn "machine profile: no alias entered -- registration skipped"
                return 2
            fi
            UI_CHOICE_KIND=new ;;
        *)
            if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ]; then
                UI_CHOICE="${UI_E_KEY[${nums[$((choice - 1))]}]}"; UI_CHOICE_KIND=claim
            else
                log_warn "machine profile: invalid choice '$choice' -- registration skipped"
                return 2
            fi ;;
    esac
    return 0
}

# ui_ask_name_company ALIAS -- on a terminal, a new profile's display name and
# company (Enter = the identity's). Sets UI_NAME, UI_COMPANY ("" = identity's).
ui_ask_name_company() {
    UI_NAME=""; UI_COMPANY=""
    if ! ui_can_ask; then return 0; fi
    printf 'Display name for %s (Enter = identity name): ' "$1" > /dev/tty
    read_tty_choice UI_NAME "identity name"
    printf 'Company for %s (Enter = identity company): ' "$1" > /dev/tty
    read_tty_choice UI_COMPANY "identity company"
}

# ui_register DIR MODE VALUE COMMIT [NAME COMPANY EMAIL] -- register this machine
# in DIR/profile.json (created when missing: --create with NAME, COMPANY, EMAIL
# and the GitHub user). MODE: refresh (this machine's profile; VALUE "" keeps its
# alias), alias (VALUE = the alias: a new profile, or this machine's renamed; ""
# = the short hostname), claim (VALUE = the key of a profile no machine owns).
# Resolver exit 4 (the alias is used by another profile; decision 1): a profile
# that belongs to no machine is claimed instead (the explicit alias names it);
# another machine's needs a confirm on a terminal, then --allow-duplicate-alias
# (that profile is never rewritten); without a terminal it is refused.
# COMMIT=true commits and pushes profile.json. Sets UI_KEY, UI_ALIAS, UI_OWNER.
# Writes the "machine profile" row. Returns 0 registered or verified, 1 failed
# (log_error + ERROR row), 2 skipped at the confirm (log_warn + WARN row).
ui_register() {
    local dir="$1" mode="$2" value="$3" commit="$4" name="${5:-}" company="${6:-}" email="${7:-}"
    local pf="$1/profile.json" tmp extra=() tries=0 rc result owner okey e ans claimed js="$repo_path/scripts/aitools-json.pl"
    tmp="$pf.tmp.$$"
    if [ "$mode" = "claim" ]; then extra=(--claim "$value")
    elif [ -n "$value" ]; then extra=(--alias "$value"); fi
    while :; do
        tries=$((tries + 1))
        local args=(register --profile "$pf" --out "$tmp" --shell "$(ui_machine_shell)" --environment "$AITOOLS_ENVIRONMENT")
        if [ -n "$name" ]; then args+=(--name "$name"); fi
        if [ -n "$company" ]; then args+=(--company "$company"); fi
        if [ ! -f "$pf" ]; then args+=(--create --github-user "$gh_user" --email "$email"); fi
        ui_profile_run "${args[@]}" ${extra[@]+"${extra[@]}"}
        rc=$UI_PROF_RC
        ui_relay_warnings
        if [ "$rc" -ne 4 ] || [ "$mode" = "claim" ] || [ "$tries" -ge 3 ]; then break; fi
        ui_rm_tmp "$tmp"
        owner=$(ui_tag owner); okey=$(ui_tag ownerKey)
        if [ "$owner" = "unregistered" ] && [ -n "$okey" ]; then
            log "machine profile: alias \"$value\" names profile $okey, which belongs to no machine -- claiming it for this machine"
            extra+=(--claim "$okey"); mode=claim
            continue
        fi
        if ! ui_can_ask; then
            log_error "machine profile: alias \"$value\" is used by another machine's profile ($okey) -- not registered without a confirm on a terminal; run: aitools user init --alias <another name>"
            write_summary ERROR "machine profile" "alias used by another machine"
            ui_action "Run: aitools user init --alias <another name> (or confirm on a terminal)"
            return 1
        fi
        printf 'Alias "%s" is used by another machine'\''s profile (%s). Use it for this machine too? [y/N]: ' "$value" "$okey" > /dev/tty
        read_tty_choice ans "no"
        case "$ans" in
            [yY]*)
                log "machine profile: alias \"$value\" shared with profile $okey (confirmed at the prompt)"
                extra+=(--allow-duplicate-alias) ;;
            *)
                log_warn "machine profile: alias \"$value\" is used by another machine's profile ($okey) -- registration skipped"
                write_summary WARN "machine profile" "skipped"
                return 2 ;;
        esac
    done
    if [ "$rc" -ne 0 ]; then
        ui_rm_tmp "$tmp"
        e=$(ui_first_error)
        if [ "$rc" -eq 3 ] || [ "$rc" -eq 4 ]; then
            log_error "machine profile: registration refused (resolver exit $rc): ${e:-see deploy.log}"
            write_summary ERROR "machine profile" "registration refused"
        else
            log_error "machine profile: register failed (resolver exit $rc): ${e:-see deploy.log}"
            write_summary ERROR "machine profile" "register failed"
        fi
        ui_action "see deploy.log -- fix profile.json, then run: aitools user init"
        return 1
    fi
    result=$(ui_tag result); UI_KEY=$(ui_tag key); UI_ALIAS=$(ui_tag alias); UI_OWNER=$(ui_tag owner); claimed=$(ui_tag claimed)
    if [ "$result" = "unchanged" ]; then
        ui_rm_tmp "$tmp"
        log_ok "machine profile: this machine is '$UI_ALIAS' (profile $UI_KEY, verified)"
        write_summary OK "machine profile" "verified ($UI_ALIAS)"
        return 0
    fi
    if ! e=$(perl "$js" check "$tmp" 2>&1); then
        ui_rm_tmp "$tmp"
        log_error "machine profile: register wrote an invalid file ($e) -- profile.json left untouched"
        write_summary ERROR "machine profile" "register validation failed"
        return 1
    fi
    backup_file "$pf"
    if ! mv "$tmp" "$pf"; then
        ui_rm_tmp "$tmp"
        log_error "machine profile: could not replace $(display_path "$pf")"
        write_summary ERROR "machine profile" "write failed"
        return 1
    fi
    log_ok "machine profile: registered this machine as '$UI_ALIAS' ($result, profile $UI_KEY${claimed:+, claimed from $claimed})"
    if [ "$commit" = "true" ] && [ -d "$dir/.git" ]; then
        ui_commit "$dir" "Register machine profile: $UI_ALIAS" profile.json  # failures: log_warn + ACTION inside
    fi
    write_summary OK "machine profile" "$result ($UI_ALIAS)"
    return 0
}

# ui_migrate DIR -- re-key alias-keyed (revision 2.1) profiles by machine id
# (resolver migrate: temp, validate, backup, move, commit profile.json, push --
# design (f); clears setup-user-config's "re-keys machine profiles" ACTION). Row
# "profile keys": OK when it re-keyed, ERROR when it failed. Returns 0, 1 failed.
ui_migrate() {
    local dir="$1" rc e
    ui_profile_run migrate --profile "$dir/profile.json"
    rc=$UI_PROF_RC
    ui_relay_warnings
    if [ "$rc" -ne 0 ]; then
        while IFS= read -r e; do if [ -n "$e" ]; then log_error "machine profile: re-key failed: $e"; fi; done <<< "$(ui_lines error)"
        if [ -z "$(ui_first_error)" ]; then log_error "machine profile: re-key failed (resolver exit $rc)"; fi
        write_summary ERROR "profile keys" "re-key failed"
        ui_action "see deploy.log -- fix profile.json, then run: aitools user init"
        return 1
    fi
    case "$(ui_tag result)" in
        migrated)
            log_ok "machine profile: profiles re-keyed by machine id: $(ui_tag renamed)"
            if [ "$(ui_tag pushed)" != "true" ]; then ui_push_action "$dir"; fi
            write_summary OK "profile keys" "re-keyed by machine id" ;;
        *) log_detail "machine profile: re-key: $(ui_tag result) (every profile is keyed by machine id)" ;;
    esac
    return 0
}

# ui_resolve DIR -- which profile this machine is. No override is passed: --alias
# goes to register, which creates a new profile (Review3 #82 M1). Sets UI_VIA,
# UI_KEY, UI_ALIAS, UI_OWNER, UI_THIS_ID. Returns 0, or 1 on a resolver error user
# init cannot resolve (log_error + ERROR row + ACTION).
ui_resolve() {
    local dir="$1" e real=false
    ui_profile_run resolve --profile "$dir/profile.json" --environment "$AITOOLS_ENVIRONMENT"
    UI_VIA=$(ui_tag via); UI_KEY=$(ui_tag key); UI_ALIAS=$(ui_tag alias); UI_OWNER=$(ui_tag owner); UI_THIS_ID=$(ui_tag machineId)
    if [ -z "$UI_KEY" ]; then UI_VIA=none; fi
    ui_relay_warnings
    log "machine profile: alias=${UI_ALIAS:-none} via=$UI_VIA key=${UI_KEY:-none} owner=${UI_OWNER:-absent}"
    if [ "$UI_PROF_RC" -eq 0 ]; then return 0; fi
    while IFS= read -r e; do
        if [ -z "$e" ]; then continue; fi
        if ui_handled "$e"; then log "machine profile: $e (user init handles this)"
        else log_error "machine profile: $e"; real=true; fi
    done <<< "$(ui_lines error)"
    if [ -z "$(ui_first_error)" ]; then log_error "machine profile: resolver failed (exit $UI_PROF_RC)"; real=true; fi
    if ! $real; then return 0; fi
    write_summary ERROR "machine profile" "resolver error"
    ui_action "see deploy.log -- fix profile.json, then run: aitools user init"
    return 1
}

# ui_identity DIR -- identity for a new profile.json: name and email from git
# (DIR's config, else the global one; the name falls back to the login name),
# company empty; each asked on a terminal with that default. Sets UI_ID_NAME,
# UI_ID_EMAIL, UI_ID_COMPANY.
ui_identity() {
    local dir="$1" v=""
    UI_ID_NAME=$(git -C "$dir" config user.name 2>/dev/null) || UI_ID_NAME=""  # unset (exit 1) or no repo yet: the fallback below
    if [ -z "$UI_ID_NAME" ]; then UI_ID_NAME=$(whoami) || UI_ID_NAME=""; fi
    UI_ID_EMAIL=$(git -C "$dir" config user.email 2>/dev/null) || UI_ID_EMAIL=""  # unset or no repo yet: asked below, else empty
    UI_ID_COMPANY=""
    if ! ui_can_ask; then return 0; fi
    printf 'Display name [%s]: ' "$UI_ID_NAME" > /dev/tty
    read_tty_choice v "$UI_ID_NAME"; if [ -n "$v" ]; then UI_ID_NAME="$v"; fi
    printf 'Email [%s]: ' "$UI_ID_EMAIL" > /dev/tty
    v=""; read_tty_choice v "${UI_ID_EMAIL:-none}"; if [ -n "$v" ]; then UI_ID_EMAIL="$v"; fi
    printf 'Company: ' > /dev/tty
    read_tty_choice UI_ID_COMPANY "none"
}

# ui_scaffold DIR COMMIT -- decision 6: DIR has no profile.json. It is created
# (register --create) with the identity (GitHub user; name and email from git,
# asked on a terminal) and this machine's profile under its id (alias: --alias,
# else asked on a terminal, else the short hostname); COMMIT=true commits and
# pushes it. Returns ui_register's code.
# TODO(PR #96): profile.json meta.intent is protected text pending approval -- the
# scaffold writes no meta.intent until it is approved (S3-M3Lead, 2026-10-22).
ui_scaffold() {
    local dir="$1" commit="$2" alias="$user_alias"
    log "machine profile: no profile.json in $(display_path "$dir") -- creating it (identity + this machine's profile)"
    ui_identity "$dir"
    if [ -z "$alias" ] && ui_can_ask; then
        printf 'Alias for this machine (Enter = hostname): ' > /dev/tty
        read_tty_choice alias "the hostname"
    fi
    ui_register "$dir" alias "$alias" "$commit" "$UI_ID_NAME" "$UI_ID_COMPANY" "$UI_ID_EMAIL"
}

# ui_register_flow DIR COMMIT -- register this machine in DIR (decisions 1, 2, 5,
# 6): scaffold a missing profile.json; refuse to write over uncommitted edits of
# profile.json; re-key legacy profiles; resolve; then register (--alias /
# AITOOLS_MACHINE_ALIAS, a refresh of this machine's profile, decision 2's cached
# alias, or the menu). Sets machine_key, machine_alias, machine_owner ("" when not
# registered). Returns 0 registered, verified or skipped by the user (WARN row),
# 1 not registered (ERROR row).
ui_register_flow() {
    local dir="$1" commit="$2" want="$user_alias" rc=0 sug="" d
    machine_key=""; machine_alias=""; machine_owner=""
    d=$(display_path "$dir")
    if [ ! -f "$dir/profile.json" ]; then
        ui_scaffold "$dir" "$commit"; rc=$?
    elif ui_profile_dirty "$dir"; then
        ui_resolve "$dir" || return 1
        if [ "$UI_OWNER" = "this" ] && { [ "$UI_VIA" = "id" ] || [ "$UI_VIA" = "environment" ]; }; then
            machine_key="$UI_KEY"; machine_alias="$UI_ALIAS"; machine_owner=this
            log_warn "machine profile: profile.json in $d has uncommitted changes -- this machine's profile ('$UI_ALIAS') was not refreshed; commit or discard them, then run: aitools user init"
            write_summary WARN "machine profile" "not refreshed (local edits)"
            ui_action "commit or discard the changes to profile.json in $d, then run: aitools user init"
            return 0
        fi
        log_error "machine profile: profile.json in $d has uncommitted changes -- not registered (they would be committed with it); commit or discard them, then run: aitools user init"
        write_summary ERROR "machine profile" "not registered (local edits)"
        ui_action "commit or discard the changes to profile.json in $d, then run: aitools user init"
        return 1
    else
        ui_migrate "$dir"  # failure: logged + ERROR row; resolution still reads legacy profiles
        ui_resolve "$dir" || return 1
        # AITOOLS_MACHINE_ALIAS naming an existing profile (resolver via=override) is used as
        # --alias would be; an unknown one is a resolver error (design (b) step 1). With
        # --alias it is ignored (user_init unsets it).
        if [ -z "$want" ] && [ "$UI_VIA" = "override" ]; then want="$UI_ALIAS"; fi
        if [ -n "$want" ]; then
            if [ "$UI_OWNER" != "this" ]; then ui_ask_name_company "$want"; else UI_NAME=""; UI_COMPANY=""; fi
            ui_register "$dir" alias "$want" "$commit" "$UI_NAME" "$UI_COMPANY" ""; rc=$?
        else
            case "$UI_VIA" in
                id|environment)
                    # Refresh the machine facts (hostname, os, arch, shell) of this machine's profile
                    ui_register "$dir" refresh "" "$commit"; rc=$? ;;
                config)
                    # This machine's id cannot be detected: config.json's cached key vouches for
                    # the profile, but register needs the id (it would refuse with exit 3)
                    log_warn "machine profile: this machine's id cannot be detected -- profile '$UI_ALIAS' (from config.json machineId) was not refreshed"
                    write_summary WARN "machine profile" "not refreshed (no machine id)"
                    # owner "config": the key is NOT passed to setup-user-config, which re-derives it
                    # (via=config) and keeps the cached machineId (review M2: with --machine-id it
                    # would read it as an override and drop the cache)
                    machine_key="$UI_KEY"; machine_alias="$UI_ALIAS"; machine_owner=config
                    return 0 ;;
                alias)
                    if [ "$AITOOLS_REGISTER_CACHED_ALIAS_SILENTLY" = "1" ]; then
                        log "machine profile: config.json names profile '$UI_KEY' (no machine.id) -- claiming it for this machine (decision 2)"
                        ui_register "$dir" claim "$UI_KEY" "$commit"; rc=$?
                    else
                        sug="$UI_KEY"; rc=100
                    fi ;;
                hostname) sug="$UI_KEY"; rc=100 ;;
                *) rc=100 ;;
            esac
            if [ "$rc" -eq 100 ]; then
                ui_choose "$dir/profile.json" "$sug" "$UI_THIS_ID"; rc=$?
                case "$rc" in
                    0)
                        if [ "$UI_CHOICE_KIND" = "claim" ]; then
                            ui_register "$dir" claim "$UI_CHOICE" "$commit"; rc=$?
                        else
                            ui_ask_name_company "$UI_CHOICE"
                            ui_register "$dir" alias "$UI_CHOICE" "$commit" "$UI_NAME" "$UI_COMPANY" ""; rc=$?
                        fi ;;
                    2) write_summary WARN "machine profile" "skipped" ;;
                esac
            fi
        fi
    fi
    case "$rc" in
        0) machine_key="$UI_KEY"; machine_alias="$UI_ALIAS"; machine_owner="$UI_OWNER"; return 0 ;;
        2) return 0 ;;
    esac
    return 1
}

# ui_v1_migrate DIR -- DIR/profile.json is v1 (no "version": 2): convert it to v2
# revision 2.2 (identity from the v1 fields, non-v1 sections kept, the other v1
# machines kept as profiles no machine owns: machine1, ...), then register this
# machine under its id (register: alias from --alias, else asked on a terminal,
# else the short hostname). Write path: temp -> validate -> backup -> move; then
# only profile.json is committed and pushed (N-Q2). config.json is not written
# here (setup-user-config is its only writer). A profile.json with uncommitted
# changes is not migrated. Returns 0 (also when nothing to do), 1 failed.
migrate_profile_v1_to_v2() {
    local dir="$1" pf="$1/profile.json" js="$repo_path/scripts/aitools-json.pl" ver tmp out rc=0 reg=0 host alias="$user_alias" d
    d=$(display_path "$dir")
    if [ ! -f "$pf" ]; then return 0; fi
    ver=$(perl "$js" get "$pf" version 2>/dev/null) || ver=""  # absent or unreadable: v1 (the node step below reports a parse error)
    if [ "$ver" = "2" ]; then return 0; fi
    if ! command -v node >/dev/null 2>&1; then
        log_warn "profile.json in $d is v1 (legacy) -- node is needed to migrate it; install node, then run: aitools user init"
        write_summary WARN "machine profile" "v1 profile not migrated"
        return 0
    fi
    if ui_profile_dirty "$dir"; then
        log_warn "profile.json in $d is v1 and has uncommitted changes -- not migrated; commit or discard them, then run: aitools user init"
        write_summary WARN "machine profile" "v1 profile not migrated"
        ui_action "commit or discard the changes to profile.json in $d, then run: aitools user init"
        return 0
    fi
    log "profile.json in $d is v1 (legacy) -- migrating to v2 (profiles keyed by machine id)"
    ui_profile_run hostname
    host="$UI_PROF_OUT"; if [ "$UI_PROF_RC" -ne 0 ]; then host=""; fi
    tmp="$pf.tmp.$$"
    out=$(node -e '
const fs = require("fs");
const [src, dst, host] = process.argv.slice(1);
const old = JSON.parse(fs.readFileSync(src, "utf8").replace(/^﻿/, ""));
const name = (old.git && old.git.name) || old.name || "";
const email = (old.git && old.git.email) || old.email || "";
const v2 = { version: 2, meta: { schemaRevision: "2.2" },
    identity: { github: old.github || "", email: email, name: name, company: old.company || "", git: { name: name, email: email } },
    profiles: {} };
// The other v1 machines: profiles that belong to no machine yet (claimable)
if (Array.isArray(old.machines)) {
    let n = 1;
    for (const m of old.machines) {
        const h = String((m && m.hostname) || "").split(".")[0].toLowerCase();
        if (host && h === host) continue;
        while (v2.profiles["machine" + n]) n++;
        v2.profiles["machine" + n] = { machine: m };
    }
}
// Non-v1 sections (e.g. cursor) are kept
const v1Keys = ["name", "email", "github", "company", "git", "machines", "version"];
for (const k of Object.keys(old)) { if (!v1Keys.includes(k) && !(k in v2)) v2[k] = old[k]; }
fs.writeFileSync(dst, JSON.stringify(v2, null, 2) + "\n");
' "$pf" "$tmp" "$host" 2>&1) || rc=$?
    if [ "$rc" -ne 0 ] || ! perl "$js" check "$tmp" > /dev/null 2>&1; then  # check prints its reason to stderr; the log line below names the failure
        ui_log_lines "v1 migration: " "$out"
        ui_rm_tmp "$tmp"
        log_error "profile.json in $d could not be migrated from v1 (see deploy.log) -- left untouched"
        write_summary ERROR "machine profile" "v1 migration failed"
        return 1
    fi
    backup_file "$pf"
    if ! mv "$tmp" "$pf"; then
        ui_rm_tmp "$tmp"
        log_error "profile.json in $d could not be replaced -- v1 migration not written"
        write_summary ERROR "machine profile" "v1 migration failed"
        return 1
    fi
    log_ok "profile.json in $d migrated to v2"
    if [ -z "$alias" ] && ui_can_ask; then
        printf 'Alias for this machine (Enter = hostname): ' > /dev/tty
        read_tty_choice alias "the hostname"
    fi
    ui_register "$dir" alias "$alias" false || reg=$?  # failure or skip: logged + row inside; the migration is committed either way
    if [ -d "$dir/.git" ]; then ui_commit "$dir" "Migrate profile.json from v1 to v2" profile.json; fi  # failures: log_warn + ACTION inside
    if [ "$reg" -eq 1 ]; then return 1; fi
    return 0
}

# ui_create_dotprofile DIR -- Path 3: a new local dotprofile in DIR: profile.json
# scaffolded with this machine's profile (decision 6), sessions/, .gitattributes,
# .gitignore, README; committed; then a private GitHub repo is created and pushed
# (the scaffold reaches the remote, N-Q2; asked on a terminal, default yes).
# Writes the "dotprofile" row. Returns 0, 1 failed (ERROR row).
ui_create_dotprofile() {
    local dir="$1" out grc=0 ans="y" reg=0 d
    d=$(display_path "$dir")
    log "user init: creating the dotprofile $d"
    if ! mkdir -p "$dir/sessions"; then
        log_error "user init: could not create $d"
        write_summary ERROR "dotprofile" "create failed"
        return 1
    fi
    ui_register_flow "$dir" false || reg=1  # failure: logged + ERROR row inside; the repo is still created
    if ! { printf '* text=auto eol=lf\n*.jsonl text eol=lf\n' > "$dir/.gitattributes" \
        && printf '.scratch/\n*.bak.*\n.DS_Store\n' > "$dir/.gitignore" \
        && printf '# %s\n\nPrivate user repo for session archives and profile data.\nSee [aitools](https://github.com/%s/aitools) for details.\n' \
            "$repo_name" "$gh_user" > "$dir/README.md"; }; then
        log_error "user init: could not write the dotprofile files in $d"
        write_summary ERROR "dotprofile" "create failed"
        return 1
    fi
    out=$(git -C "$dir" init -b main 2>&1) || grc=$?
    if [ "$grc" -eq 0 ] && [ -n "${UI_ID_NAME:-}" ]; then out=$(git -C "$dir" config user.name "$UI_ID_NAME" 2>&1) || grc=$?; fi
    if [ "$grc" -eq 0 ] && [ -n "${UI_ID_EMAIL:-}" ]; then out=$(git -C "$dir" config user.email "$UI_ID_EMAIL" 2>&1) || grc=$?; fi
    if [ "$grc" -eq 0 ]; then out=$(git -C "$dir" add -A 2>&1) || grc=$?; fi
    if [ "$grc" -eq 0 ]; then out=$(git -C "$dir" commit -m "Initial commit: profile and session archive structure" 2>&1) || grc=$?; fi
    ui_log_lines "git: " "$out"
    if [ "$grc" -ne 0 ]; then
        log_error "user init: git init / first commit failed in $d (exit $grc, see deploy.log) -- commit it by hand, then run: aitools user init"
        write_summary ERROR "dotprofile" "first commit failed"
        ui_action "commit the dotprofile in $d, then run: aitools user init"
        return 1
    fi
    log_ok "user init: dotprofile created and committed"
    if ! command -v gh >/dev/null 2>&1; then
        log_warn "user init: gh not found -- the dotprofile was not pushed; create the private GitHub repo $repo_name and push it"
        write_summary WARN "dotprofile" "created, not pushed"
        ui_action "Run: gh repo create $repo_name --private --source $d --push"
        return "$reg"
    fi
    if ui_can_ask; then
        printf "Create the private GitHub repo '%s' and push? [Y/n]: " "$repo_name" > /dev/tty
        read_tty_choice ans "yes"
        if [ -z "$ans" ]; then ans="y"; fi
    fi
    case "$ans" in
        [yY]*) ;;
        *)
            log_warn "user init: GitHub repo not created -- the dotprofile stays local; create it and push: gh repo create $repo_name --private --source $d --push"
            write_summary WARN "dotprofile" "created, not pushed"
            ui_action "Run: gh repo create $repo_name --private --source $d --push"
            return "$reg" ;;
    esac
    grc=0
    if ui_can_ask; then
        out=$(gh repo create "$repo_name" --private --source "$dir" --push 2>&1) || grc=$?
    else
        out=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}" gh repo create "$repo_name" --private --source "$dir" --push 2>&1) || grc=$?
    fi
    ui_log_lines "gh repo create: " "$out"
    if [ "$grc" -ne 0 ]; then
        log_warn "user init: gh repo create failed (exit $grc, see deploy.log) -- the dotprofile stays local; run: gh repo create $repo_name --private --source $d --push"
        write_summary WARN "dotprofile" "created, not pushed"
        ui_action "Run: gh repo create $repo_name --private --source $d --push"
        return "$reg"
    fi
    log_ok "user init: private GitHub repo $gh_user/$repo_name created and pushed"
    write_summary OK "dotprofile" "created"
    return "$reg"
}

# ui_scaffold_claude_md DIR -- the dotprofile's claude/CLAUDE.md from the shared
# template when it is missing, committed (only that file) and pushed (Review3
# INCIDENT: identity fallback, results checked, no `|| true`). Returns 0, 1 failed.
ui_scaffold_claude_md() {
    local dir="$1" dest="$1/claude/CLAUDE.md" src="$repo_path/shared/claude-shared.md"
    if [ -f "$dest" ]; then return 0; fi
    if [ ! -f "$src" ]; then
        log_warn "user init: $(display_path "$src") not found -- claude/CLAUDE.md not created in the dotprofile"
        write_summary WARN "claude template" "template missing"
        return 0
    fi
    if ! { mkdir -p "$dir/claude" && cp "$src" "$dest"; }; then
        log_error "user init: could not create $(display_path "$dest")"
        write_summary ERROR "claude template" "create failed"
        return 1
    fi
    log_ok "user init: created claude/CLAUDE.md in the dotprofile (template with placeholders)"
    if [ -d "$dir/.git" ]; then ui_commit "$dir" "Add claude/CLAUDE.md template" claude/CLAUDE.md; fi  # failures: log_warn + ACTION inside
    write_summary OK "claude template" "created"
    return 0
}

# user_init -- `aitools user init`: the dotprofile (Path 1 present, Path 2 cloned
# from GitHub, Path 3 created), this machine's profile, the CLAUDE.md template,
# config.json (setup-user-config, its only writer) and the session archive hook.
# Returns 0 done (warnings possible), 1 any failure, 2 user abort in a review menu
# (D-TS13). The caller creates and shows the run summary (decision 3).
user_init() {
    local rc=0 raw repos_dir user_repo_dir out crc=0 dn de wrc=0 hook_rc=0 hook_setup
    local writer_args=() no_machine=false
    gh_user=""; repo_name=""; machine_key=""; machine_alias=""; machine_owner=""
    # --force: no prompts here, and the review menus of setup-user-hooks take the source
    if $force; then export AITOOLS_FORCE=1; fi

    # GitHub user: gh, else config.json githubUser, else asked on a terminal
    if command -v gh >/dev/null 2>&1; then
        # gh exits non-zero when it is not signed in: the -z test below falls back
        if gh_user=$(gh api user --jq '.login' 2>/dev/null); then :; else gh_user=""; fi
    fi
    if [ -z "$gh_user" ]; then gh_user=$(read_config_key "$config" githubUser) || gh_user=""; fi  # absent: asked below
    if [ -z "$gh_user" ] && ui_can_ask; then
        printf 'GitHub username: ' > /dev/tty
        read_tty_choice gh_user "none"
    fi
    if [ -z "$gh_user" ]; then
        log_error "user init: GitHub username unknown (gh not signed in, no githubUser in config.json, no terminal to ask) -- run: gh auth login, then aitools user init"
        write_summary ERROR "dotprofile" "GitHub user unknown"
        ui_action "Run: gh auth login, then aitools user init"
        return 1
    fi
    log "user init: GitHub user $gh_user"
    repo_name="aitools-${gh_user}"

    # Repos directory from config.json (a leading ~ is the home directory)
    repos_dir=""
    if raw=$(read_config_key "$config" "reposPath"); then repos_dir=$(to_native_path "$raw"); fi
    case "$repos_dir" in
        "~") repos_dir="$HOME" ;;
        "~/"*) repos_dir="$HOME/${repos_dir#\~/}" ;;
    esac
    repos_dir="${repos_dir:-$HOME/repos}"
    # A relative reposPath would put the dotprofile (and its GitHub repo) under the
    # current directory, and setup-user-config refuses it anyway (review M1): refused
    case "$repos_dir" in
        /*) ;;
        *)
            log_error "user init: reposPath in $(display_path "$config") is not an absolute path ($repos_dir) -- set an absolute reposPath (or run: aitools install --repos-path <absolute path>), then run: aitools user init"
            write_summary ERROR "dotprofile" "reposPath not absolute"
            ui_action "Set an absolute reposPath in $(display_path "$config"), then run: aitools user init"
            return 1 ;;
    esac
    user_repo_dir="$repos_dir/$repo_name"
    # --alias wins over a (possibly stale) AITOOLS_MACHINE_ALIAS, for the resolver and
    # the writer alike (review m3)
    if [ -n "$user_alias" ] && [ -n "${AITOOLS_MACHINE_ALIAS:-}" ]; then
        log "user init: AITOOLS_MACHINE_ALIAS=$AITOOLS_MACHINE_ALIAS ignored (--alias $user_alias given)"
        unset AITOOLS_MACHINE_ALIAS
    fi

    if [ -d "$user_repo_dir/.git" ]; then
        # --- Path 1: local dotprofile present ---
        log "user init: dotprofile $(display_path "$user_repo_dir") (present)"
        write_summary OK "dotprofile" "verified"
        migrate_profile_v1_to_v2 "$user_repo_dir" || rc=1
        ui_register_flow "$user_repo_dir" true || rc=1
    elif command -v gh >/dev/null 2>&1 && gh repo view "$gh_user/$repo_name" --json name >/dev/null 2>&1; then
        # gh repo view exits non-zero when the repo does not exist (or gh is not signed in): that is the test
        # --- Path 2: GitHub repo present, no local clone ---
        log "user init: cloning $gh_user/$repo_name to $(display_path "$user_repo_dir")"
        out=$(gh repo clone "$gh_user/$repo_name" "$user_repo_dir" 2>&1) || crc=$?
        ui_log_lines "gh repo clone: " "$out"
        if [ "$crc" -ne 0 ]; then
            log_error "user init: gh repo clone $gh_user/$repo_name failed (exit $crc, see deploy.log) -- clone it, then run: aitools user init"
            write_summary ERROR "dotprofile" "clone failed"
            ui_action "Run: gh repo clone $gh_user/$repo_name $(display_path "$user_repo_dir"), then aitools user init"
            return 1
        fi
        write_summary OK "dotprofile" "cloned"
        # Git identity for this clone from the profile, so the commits below work on a
        # fresh machine (Review3 #82 minor 8: results checked)
        if [ -f "$user_repo_dir/profile.json" ]; then
            dn=$(perl "$repo_path/scripts/aitools-json.pl" get "$user_repo_dir/profile.json" identity git name) || dn=""  # absent: keep git's own identity
            de=$(perl "$repo_path/scripts/aitools-json.pl" get "$user_repo_dir/profile.json" identity git email) || de=""  # absent: keep git's own identity
            if [ -n "$dn" ] && [ -n "$de" ]; then
                crc=0
                out=$(git -C "$user_repo_dir" config user.name "$dn" 2>&1) || crc=$?
                if [ "$crc" -eq 0 ]; then out=$(git -C "$user_repo_dir" config user.email "$de" 2>&1) || crc=$?; fi
                if [ "$crc" -ne 0 ]; then
                    log_warn "user init: could not set the git identity of the clone (exit $crc: $out) -- commits use git's own identity"
                fi
            fi
        fi
        migrate_profile_v1_to_v2 "$user_repo_dir" || rc=1
        ui_register_flow "$user_repo_dir" true || rc=1
    else
        # --- Path 3: fresh setup ---
        ui_create_dotprofile "$user_repo_dir" || rc=1
    fi
    # This machine without a profile at the end (skipped at a prompt, refused, failed)
    # is one outcome with one exit code, 1 (Review3 #82 minor 3)
    if [ -z "$machine_key" ]; then
        # A skip at a prompt wrote a WARN row only: name the reason for the exit code (review n1)
        if [ "$rc" -eq 0 ]; then log_error "machine profile: this machine is not registered (skipped) -- run: aitools user init"; fi
        rc=1
        # Reported here: setup-user-config gets --no-machine, so it adds no second
        # machine-profile ERROR / ACTION (M3-FINISH item 2). Decided here, not from an
        # empty machine_key at the writer call: the owner "config" branch below also
        # empties it for a registered machine whose id cannot be detected.
        no_machine=true
    fi

    if [ -d "$user_repo_dir" ]; then ui_scaffold_claude_md "$user_repo_dir" || rc=1; fi

    # config.json has one writer (setup-user-config): GitHub user, dotprofile path and
    # this machine's profile key (--machine-id; ConfigKey contract). Another
    # machine's key is never passed (ConfigKey Q3); a key that only config.json
    # vouches for (owner "config") is left to the writer to re-derive (review M2).
    # An unregistered machine (no_machine) gets --no-machine instead of a key.
    if [ "$machine_owner" = "config" ]; then
        log_detail "user init: machine id undetectable -- --machine-id not passed (the writer keeps the cached machineId)"
        machine_key=""
    elif [ -n "$machine_key" ] && [ "$machine_owner" != "this" ]; then
        log_error "user init: profile $machine_key is not this machine's (owner ${machine_owner:-unknown}) -- not passed to setup-user-config"
        write_summary ERROR "machine profile" "not this machine's profile"
        machine_key=""; rc=1
    fi
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            writer_args=(-GithubUser "$gh_user" -UserRepoPath "$(cygpath -w "$user_repo_dir")")
            if [ -n "$machine_key" ]; then writer_args+=(-MachineId "$machine_key")
            elif $no_machine; then writer_args+=(-NoMachine); fi
            pwsh -NoProfile -ExecutionPolicy Bypass \
                -File "$(cygpath -w "$repo_path/scripts/setup-user-config.ps1")" "${writer_args[@]}" || wrc=$?
            ;;
        *)
            writer_args=(--github-user "$gh_user" --user-repo-path "$user_repo_dir")
            if [ -n "$machine_key" ]; then writer_args+=(--machine-id "$machine_key")
            elif $no_machine; then writer_args+=(--no-machine); fi
            "${BASH:-bash}" "$repo_path/scripts/setup-user-config.sh" "${writer_args[@]}" || wrc=$?
            ;;
    esac
    if [ "$wrc" -ne 0 ]; then
        log_error "user init: setup-user-config failed (exit $wrc) -- see $LOG_DISPLAY"
        write_summary ERROR "aitools config" "setup-user-config failed"
        rc=1
    fi

    # Session archive hook. Exit 2 = the user aborted in the review menu (D-TS13):
    # stop with exit 2; any other failure is logged.
    log "user init: deploying the session archive hook"
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            hook_setup="$repo_path/scripts/setup-user-hooks.ps1"
            if [ -f "$hook_setup" ]; then
                pwsh -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$hook_setup")" || hook_rc=$?
            else hook_rc=127; fi
            ;;
        *)
            hook_setup="$repo_path/scripts/setup-user-hooks.sh"
            if [ -f "$hook_setup" ]; then "${BASH:-bash}" "$hook_setup" || hook_rc=$?; else hook_rc=127; fi
            ;;
    esac
    if [ "$hook_rc" -eq 2 ]; then
        log "user init: aborted by user"
        return 2
    fi
    if [ "$hook_rc" -eq 127 ]; then
        log_error "user init: $(display_path "$hook_setup") not found -- the session archive hook was not deployed"
        write_summary ERROR "claude hooks" "setup script missing"
        rc=1
    elif [ "$hook_rc" -ne 0 ]; then
        log_error "user init: $(basename "$hook_setup") failed (exit $hook_rc) -- see $LOG_DISPLAY"
        rc=1
    fi
    if [ "$rc" -eq 0 ]; then
        log_ok "user init: done -- sessions will be archived to $(display_path "$user_repo_dir/sessions/")"
    fi
    return "$rc"
}

# Version string from a git repo using tag-based scheme.
# v0.14.0              → 0.14.0       (on tag exactly)
# v0.14.0-5-gabcdef    → 0.14.0+5    (5 commits ahead of tag)
# The +N suffix indicates unreleased commits; it is never a real version.
repo_version() {
    local desc
    desc=$(git -C "$1" describe --tags --match "v*" 2>/dev/null) || true
    if [ -n "$desc" ]; then
        local base="${desc#v}"              # strip leading v
        if [[ "$base" =~ ^(.*)-([0-9]+)-g[0-9a-f]+$ ]]; then
            local tag_part="${BASH_REMATCH[1]}"   # 0.14.0
            local commits="${BASH_REMATCH[2]}"    # 5
            echo "${tag_part}+${commits}"
        else
            echo "$base"
        fi
    else
        # No tags yet — fallback to date + hash
        git -C "$1" log -1 --format='%cd (%h)' --date=short 2>/dev/null || echo "unknown"
    fi
}

# deploy_abort SCRIPT -- deploy-harness exited 2: the user chose [x]abort at a review
# menu (D-TS13; abort ends the whole run, T-Q3). The remaining deploy steps are not
# run; the caller shows the summary and returns 2. Parity: Invoke-DeployAbort in
# aitools.ps1.
deploy_abort() {
    deploy_aborted=true
    log "$1: aborted by user at a review menu -- remaining deploy steps not run"
    write_summary WARN "harness files" "aborted by user"
}

# Deploy all config scripts from the repo's scripts/ directory.
# On Windows (Git Bash), calls .ps1 variants via pwsh.
# Child scripts log to LOG_FILE themselves (via tee/Add-Content), so we
# redirect stdout to /dev/null to prevent double-logging.
deploy_configs() {
    local script_dir="$1"
    local errors=0
    deploy_aborted=false   # global: the caller reads it (deploy_abort sets it)
    export AITOOLS_DEPLOY=1
    if $dry_run; then export AITOOLS_DRY_RUN=1; fi
    if $force; then export AITOOLS_FORCE=1; fi
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            if ! command -v pwsh &>/dev/null; then
                log_error "pwsh (PowerShell 7) not found. Install: winget install --id Microsoft.PowerShell --source winget"
                return 1
            fi
            # deploy-harness first: it fills ~/.aitools and runs the config writer
            # (setup-user-config) itself, so the writer is not in this list (once per run)
            local deploy_scripts="deploy-harness.ps1 setup-user-claude.ps1 setup-user-mcp.ps1 setup-user-skills.ps1 setup-cursor-ide-mcp.ps1 setup-user-cursor.ps1 setup-user-settings.ps1 setup-user-hooks.ps1"
            for script in $deploy_scripts; do
                local script_path="$script_dir/$script"
                if [ -f "$script_path" ]; then
                    # Validate PS1 syntax before executing; each parse error is
                    # printed by the check and logged as detail.
                    local parse_out parse_rc=0 parse_line
                    parse_out=$(pwsh -NoProfile -Command "
                        \$e = \$null
                        \$null = [System.Management.Automation.Language.Parser]::ParseFile('$(cygpath -w "$script_path")', [ref]\$null, [ref]\$e)
                        foreach (\$x in \$e) { 'line ' + \$x.Extent.StartLineNumber + ': ' + \$x.Message }
                        if (\$e.Count -gt 0) { exit 1 }
                    " 2>&1) || parse_rc=$?
                    if [ "$parse_rc" -ne 0 ]; then
                        while IFS= read -r parse_line; do
                            if [ -n "$parse_line" ]; then log_detail "$script parse: $parse_line"; fi
                        done <<< "$parse_out"
                        log_error "$script has parse errors -- skipped (see $LOG_DISPLAY)"
                        write_summary ERROR "${script%.ps1}" "parse errors -- skipped"
                        errors=$((errors + 1))
                        continue
                    fi
                    # Run without output redirection -- child PS1 scripts log to
                    # deploy.log via [IO.File]::AppendAllText. PowerShell's 2>> holds
                    # an exclusive file lock that blocks the child's AppendAllText.
                    # deploy-harness.ps1 is not relayed here: a PS1 review prompt is
                    # written to stdout without a newline, and a relay reading pwsh's
                    # stdout line by line would hold it until the user answered.
                    local script_rc=0 row_tool="${script%.ps1}"
                    if [ "$script" = "deploy-harness.ps1" ]; then row_tool="harness files"; fi
                    pwsh -NoProfile -ExecutionPolicy Bypass \
                        -File "$(cygpath -w "$script_path")" || script_rc=$?
                    if [ "$script" = "deploy-harness.ps1" ] && [ "$script_rc" -eq 2 ]; then
                        deploy_abort "$script"
                        break
                    fi
                    if [ "$script_rc" -ne 0 ]; then
                        log_error "$script failed (exit $script_rc) -- see $LOG_DISPLAY"
                        write_summary ERROR "$row_tool" "script failed (exit $script_rc)"
                        errors=$((errors + 1))
                    fi
                else
                    log_warn "$script not found -- skipping"
                fi
                # Show cloud MCP status after setup-user-mcp
                case "$script" in
                    setup-user-mcp.*) show_cloud_mcp install setup-user-mcp ;;
                esac
            done
            ;;
        *)
            # deploy-harness first: it fills ~/.aitools and runs the config writer
            # (setup-user-config) itself, so the writer is not in this list (once per run)
            local deploy_scripts="deploy-harness.sh setup-user-claude.sh setup-user-mcp.sh setup-user-skills.sh setup-cursor-ide-mcp.sh setup-user-cursor.sh setup-user-settings.sh setup-user-hooks.sh"
            for script in $deploy_scripts; do
                local script_path="$script_dir/$script"
                if [ -f "$script_path" ]; then
                    # Validate bash syntax before executing; bash -n's messages
                    # are logged as detail.
                    local syntax_out syntax_rc=0 syntax_line
                    syntax_out=$(bash -n "$script_path" 2>&1) || syntax_rc=$?
                    if [ "$syntax_rc" -ne 0 ]; then
                        while IFS= read -r syntax_line; do
                            if [ -n "$syntax_line" ]; then log_detail "$script syntax: $syntax_line"; fi
                        done <<< "$syntax_out"
                        log_error "$script has syntax errors -- skipped (see $LOG_DISPLAY)"
                        write_summary ERROR "${script%.sh}" "syntax errors -- skipped"
                        errors=$((errors + 1))
                        continue
                    fi
                    # Run without output redirection -- child scripts log to
                    # deploy.log via >> append. Removing redirection ensures
                    # parity with the Windows fix and lets errors surface.
                    local script_rc=0
                    if [ "$script" = "deploy-harness.sh" ]; then
                        # Relayed (aitools-lib run_child_relayed): stdout to the console
                        # and deploy.jsonl; stdin stays the terminal (the review menu
                        # reads /dev/tty). The lib logs the error for a failed run.
                        run_child_relayed "$script" "${BASH:-bash}" "$script_path" || script_rc="$AITLIB_CHILD_RC"
                        # Exit 0 with error lines: the lib logged it; count it as a failure
                        if [ "$script_rc" -eq 0 ] && [ "$AITLIB_CHILD_ERRORS" -gt 0 ]; then script_rc=1; fi
                        if [ "$script_rc" -eq 2 ]; then
                            deploy_abort "$script"
                            break
                        fi
                        if [ "$script_rc" -ne 0 ]; then
                            write_summary ERROR "harness files" "script failed (exit $script_rc)"
                            errors=$((errors + 1))
                        fi
                        continue
                    fi
                    bash "$script_path" || script_rc=$?
                    if [ "$script_rc" -ne 0 ]; then
                        log_error "$script failed (exit $script_rc) -- see $LOG_DISPLAY"
                        write_summary ERROR "${script%.sh}" "script failed (exit $script_rc)"
                        errors=$((errors + 1))
                    fi
                else
                    log_warn "$script not found -- skipping"
                fi
                # Show cloud MCP status after setup-user-mcp
                case "$script" in
                    setup-user-mcp.*) show_cloud_mcp install setup-user-mcp ;;
                esac
            done
            ;;
    esac

    # [x]abort in deploy-harness: the run stops here (the caller returns 2)
    if $deploy_aborted; then
        unset AITOOLS_DEPLOY
        unset AITOOLS_DRY_RUN
        unset AITOOLS_FORCE
        return "$errors"
    fi

    # Best-effort: mirror relay.md into ~/.cursor/AGENTS.md (Cursor IDE).
    # Non-fatal if Python or sync fails.
    local sync_py="$script_dir/sync-relay-to-cursor-agents.py"
    if [ -f "$sync_py" ]; then
        local sync_args=()
        if $dry_run; then sync_args+=(--dry-run); fi
        # Deploy-formatted line comes from Python when AITOOLS_SYNC_DEPLOY_LOG=1 (not --dry-run).
        if ! $dry_run; then export AITOOLS_SYNC_DEPLOY_LOG=1; fi
        if command -v python3 &>/dev/null; then
            if python3 "$sync_py" "${sync_args[@]}" >>"$LOG_FILE" 2>&1; then
                if $dry_run; then log_ok "relay→AGENTS sync (dry-run)"; fi
            else
                log_warn "sync-relay-to-cursor-agents.py failed (non-fatal)"
            fi
        elif command -v py &>/dev/null; then
            if py -3 "$sync_py" "${sync_args[@]}" >>"$LOG_FILE" 2>&1; then
                if $dry_run; then log_ok "relay→AGENTS sync (dry-run)"; fi
            else
                log_warn "sync-relay-to-cursor-agents.py failed (non-fatal)"
            fi
        else
            log_warn "Python not found — skipping relay→AGENTS sync"
        fi
        unset AITOOLS_SYNC_DEPLOY_LOG 2>/dev/null || true
    fi

    unset AITOOLS_DEPLOY
    unset AITOOLS_DRY_RUN
    unset AITOOLS_FORCE
    return $errors
}

# ---------------------------------------------------------------------------
# MCP server registry
# ---------------------------------------------------------------------------

# Returns URL for a known MCP server name, or empty string if unknown.
mcp_server_url() {
    case "$1" in
        vercel)  echo "https://mcp.vercel.com" ;;
        webflow) echo "https://mcp.webflow.com/mcp" ;;
        *)       echo "" ;;
    esac
}

# Display cloud MCP servers from claude.ai configuration.
# Usage: show_cloud_mcp <context> [script_name]
#   context: "mcp" (concise header) or "install" (descriptive header)
#   script_name: if set, uses structured logging with [timestamp] [script_name] prefix
# Silent no-op if claude CLI unavailable or no cloud servers found.
show_cloud_mcp() {
    local context="${1:-mcp}"
    local script_name="${2:-}"
    command -v claude &>/dev/null || return 0

    local saved_claudecode="${CLAUDECODE:-}"
    unset CLAUDECODE

    local raw
    raw=$(claude mcp list 2>/dev/null) || true

    if [ -n "$saved_claudecode" ]; then
        export CLAUDECODE="$saved_claudecode"
    fi

    [ -n "$raw" ] || return 0

    local parsed
    parsed=$(printf '%s\n' "$raw" | perl -ne '
        s/\e\[[0-9;]*m//g;
        next unless /^claude\.ai\s+(.+?):\s+.+\s+-\s+(.+)$/;
        my ($name, $status) = ($1, $2);
        $status =~ s/\s+$//;
        my $pad = length($name) < 24 ? " " x (24 - length($name)) : " ";
        printf "  %s%s%s\n", $name, $pad, $status;
    ')

    [ -n "$parsed" ] || return 0

    if [ -n "$script_name" ]; then
        # Structured logging for deploy sequence
        local ts
        ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        printf '[%s] [%s] Cloud MCP servers (configured at claude.ai):\n' "$ts" "$script_name"
        while IFS= read -r line; do
            printf '[%s] [%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$script_name" "$line"
        done <<< "$parsed"
    else
        echo ""
        echo "Cloud (claude.ai):"
        printf '%s\n' "$parsed"
    fi
}

# show_summary is provided by aitools-lib.sh (sourced after repo_path is resolved)

# ---------------------------------------------------------------------------
# Usage / flags
# ---------------------------------------------------------------------------

usage() {
    cat <<'EOF'
Usage: aitools [COMMAND] [OPTIONS]

Commands:
  (none)               Sync configs: pull + rebuild + deploy all configurations
                       (deploy includes relay → ~/.cursor/AGENTS.md when Python is available)
  gitpull [--patch]    Update source: pull + rebuild + deploy + changelog + version tag
                       --patch: bump patch (v0.14.0 -> v0.14.1) instead of minor
  install              Full setup: pull + rebuild + install tools + deploy configs
                       (install Step 22 / deploy: relay → Cursor AGENTS.md mirror)
  mcp                  Show MCP server status for current project
  user init            Set up user repo, register this machine's profile, configure session archiving hook
  user init --alias A  Same, registering this machine as profile A without a prompt
  sessions list [proj] List archived sessions (optionally filter by project)
  sessions archive ID  Manually archive a session by ID (full or prefix)
  sessions move F proj Refile an archived session under a different project
  dashboard            Start the live mission control dashboard server
                       --stop: stop the server  --status: show server status
                       --snapshot: generate static HTML  --background: for hooks

Options:
  --addmcp <name...>   Enable MCP server(s) for current project (vercel, webflow)
  --dry-run            Preview what would change without writing any files
  --force              No prompts: managed files take the source version (backups
                       kept); with install, also skips gh login and path prompts
  --version, -v        Show installed and repo version
  --help, -h           Show this help

Install flags (passed through to installer):
  --skip-gh-auth       Skip GitHub CLI authentication
  --repos-path PATH    Set repos directory without prompting
  --skip-drive-detection  Skip Google Drive auto-detection
EOF
}

show_version=false
show_help=false
do_install=false
do_gitpull=false
gitpull_patch=false
do_mcp_status=false
do_user=false
user_subcmd=""
do_sessions=false
sessions_subcmd=""
sessions_args=()
do_dashboard=false
dashboard_args=()
addmcp_seen=false
addmcp_servers=()
dry_run=false
force=false
user_alias=""
passthrough=()

# Capture original args before the parse loop consumes them (shift). The
# smart-reload re-exec below must replay the user's intent (e.g. `install`);
# by that point "$@" is empty, so it would silently degrade to the sync path.
_ORIG_ARGS=("$@")

while [[ $# -gt 0 ]]; do
    case "$1" in
        --version|-v) show_version=true; shift ;;
        --help|-h)    show_help=true; shift ;;
        --dry-run)    dry_run=true; shift ;;
        --force)      force=true; shift ;;
        --alias)
            # aitools user init --alias <alias>: register this machine without a prompt (P-Q12)
            if [[ $# -lt 2 || "$2" =~ ^-- ]]; then
                printf 'aitools: --alias needs a value\n' >&2
                return 1
            fi
            user_alias="$2"; shift 2 ;;
        install)      do_install=true; shift ;;
        gitpull)
            do_gitpull=true; shift
            if [[ $# -gt 0 && "$1" == "--patch" ]]; then
                gitpull_patch=true; shift
            fi
            ;;
        mcp)          do_mcp_status=true; shift ;;
        user)
            do_user=true
            shift
            if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
                user_subcmd="$1"; shift
            fi
            ;;
        sessions)
            do_sessions=true
            shift
            if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
                sessions_subcmd="$1"; shift
            fi
            # Collect remaining positional args for sessions subcommands
            while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
                sessions_args+=("$1")
                shift
            done
            ;;
        dashboard)
            do_dashboard=true
            shift
            # Collect all remaining args for dashboard subcommand
            while [[ $# -gt 0 ]]; do
                dashboard_args+=("$1")
                shift
            done
            ;;
        --addmcp)
            addmcp_seen=true
            shift
            # Collect all following args that don't start with --
            while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
                addmcp_servers+=("$1")
                shift
            done
            ;;
        *)            passthrough+=("$1"); shift ;;
    esac
done

if $show_help; then
    usage
    return 0
fi

# Warnings found before the lib is loaded (it holds the logging); logged right after.
_pre_lib_warnings=()

# ---------------------------------------------------------------------------
# Migrate config directory: ~/.config/ai-tooling/ -> ~/.aitools/
# ---------------------------------------------------------------------------

old_config_dir="$HOME/.config/ai-tooling"
new_config_dir="$HOME/.aitools"

if [ -d "$old_config_dir" ] && [ ! -d "$new_config_dir" ]; then
    mv "$old_config_dir" "$new_config_dir"
elif [ -d "$old_config_dir" ] && [ -d "$new_config_dir" ]; then
    _pre_lib_warnings+=("both $old_config_dir and $new_config_dir exist -- using $new_config_dir")
fi

# ---------------------------------------------------------------------------
# Resolve repo path from config
# ---------------------------------------------------------------------------

config="$HOME/.aitools/config.json"
repo_path=""

if raw=$(read_config_key "$config" "repoPath") || raw=$(read_config_key "$config" "aiToolingRepoPath"); then
    repo_path=$(to_native_path "$raw")
fi
repo_path="${repo_path:-$HOME/repos/aitools}"

# Auto-migrate: aiToolingRepoPath -> repoPath (repo renamed ai-tooling -> aitools)
if read_config_key "$config" "aiToolingRepoPath" >/dev/null 2>&1; then
    if command -v node &>/dev/null; then
        migrate_out=$(node -e "
const fs = require('fs');
const f = process.argv[1];
try {
    const cfg = JSON.parse(fs.readFileSync(f, 'utf8'));
    if (!cfg.repoPath && cfg.aiToolingRepoPath) {
        cfg.repoPath = cfg.aiToolingRepoPath.replace(/ai-tooling/g, 'aitools');
    }
    delete cfg.aiToolingRepoPath;
    fs.writeFileSync(f, JSON.stringify(cfg, null, 2) + '\n');
    console.log('migrated');
} catch (e) {
    console.error('config migration failed: ' + e.message);
    process.exit(1);
}
" "$config" 2>&1) || _pre_lib_warnings+=("config key migration failed: $migrate_out")
        # Re-read repo_path after migration
        if raw=$(read_config_key "$config" "repoPath"); then
            repo_path=$(to_native_path "$raw")
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Verify repo exists (clone fresh if missing). Runs before the lib is loaded --
# the lib lives in the repo -- so status goes to the console directly and the
# event is logged as a warning once the lib is up.
# ---------------------------------------------------------------------------

if [ ! -d "$repo_path/.git" ] && ! $show_version; then
    printf 'aitools: repo not found at %s -- cloning fresh...\n' "$repo_path"
    mkdir -p "$(dirname "$repo_path")"
    if ! git clone https://github.com/nobul-tech/aitools.git "$repo_path"; then
        printf 'error: failed to clone the aitools repo to %s\n' "$repo_path" >&2
        return 1
    fi
    _pre_lib_warnings+=("Repo was not found at $repo_path -- cloned fresh")
fi

# ---------------------------------------------------------------------------
# Load aitools-lib (logging, display_path, write_summary, ...) for every command.
# Without the repo nothing below can run; --version still answers.
# ---------------------------------------------------------------------------

aitools_lib="$repo_path/scripts/aitools-lib.sh"
if [ ! -f "$aitools_lib" ]; then
    if $show_version; then
        echo "aitools $AITOOLS_INSTALLED_VERSION"
        echo "  repo: not found at $repo_path"
        return 0
    fi
    printf 'error: aitools-lib.sh not found at %s -- check repoPath in %s\n' "$aitools_lib" "$config" >&2
    return 1
fi
source "$aitools_lib"
logging_init "aitools"
LOG_DISPLAY=$(display_path "$LOG_FILE")
for _w in ${_pre_lib_warnings[@]+"${_pre_lib_warnings[@]}"}; do
    log_warn "$_w"
done

# Reject unknown arguments when not installing (typos like "installs", "mcpp", etc.)
if ! $do_install && [ ${#passthrough[@]} -gt 0 ]; then
    log_error "unknown argument '${passthrough[0]}'"
    echo "Run 'aitools --help' for usage."
    return 1
fi

# Reject --addmcp with no server names
if $addmcp_seen && [ ${#addmcp_servers[@]} -eq 0 ]; then
    log_error "--addmcp requires at least one server name (vercel, webflow)"
    return 1
fi

# ---------------------------------------------------------------------------
# --version
# ---------------------------------------------------------------------------

if $show_version; then
    echo "aitools $AITOOLS_INSTALLED_VERSION"
    if [ -d "$repo_path/.git" ]; then
        echo "  repo: $(repo_version "$repo_path") @ $(display_path "$repo_path")"
    fi
    return 0
fi

# ---------------------------------------------------------------------------
# mcp — show MCP server status
# ---------------------------------------------------------------------------

if $do_mcp_status; then
    if ! command -v node &>/dev/null; then
        log_error "node required for mcp status"
        return 1
    fi

    node -e '
const fs = require("fs");
const path = require("path");
const os = require("os");

const home = os.homedir();
const cwd = process.cwd();

function readJson(f) {
    try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; }
}

// --- Claude Code ---
const claudeJson = readJson(path.join(home, ".claude.json"));
const claudeSettings = readJson(path.join(home, ".claude", "settings.json"));
const projectSettings = readJson(path.join(cwd, ".claude", "settings.json"));
const projectLocalSettings = readJson(path.join(cwd, ".claude", "settings.local.json"));

const claudeDeny = claudeSettings?.permissions?.deny || [];
const projectAllow = [
    ...(projectSettings?.permissions?.allow || []),
    ...(projectLocalSettings?.permissions?.allow || []),
];

console.log("MCP Server Status (" + cwd + ")\n");

if (claudeJson?.mcpServers) {
    console.log("Claude Code:");
    const servers = claudeJson.mcpServers;
    for (const [name, cfg] of Object.entries(servers)) {
        const transport = cfg.type === "http" || cfg.url ? "http" : "stdio";
        const denyPattern = "MCP(" + name + ")";
        const denied = claudeDeny.includes(denyPattern);
        const allowed = projectAllow.includes(denyPattern);
        const status = denied && !allowed ? "disabled" : "enabled";
        const pad = name.length < 16 ? " ".repeat(16 - name.length) : " ";
        console.log("  " + name + pad + status.padEnd(10) + "(user)   " + transport);
    }

    // Show project overrides if any
    const overrides = [];
    for (const rule of projectAllow) {
        const match = rule.match(/^MCP\((.+)\)$/);
        if (match) {
            const source = projectLocalSettings?.permissions?.allow?.includes(rule)
                ? ".claude/settings.local.json"
                : ".claude/settings.json";
            overrides.push({ name: match[1], source });
        }
    }
    if (overrides.length > 0) {
        console.log("  Project overrides:");
        for (const o of overrides) {
            const pad = o.name.length < 16 ? " ".repeat(16 - o.name.length) : " ";
            console.log("    " + o.name + pad + "enabled   (" + o.source + ")");
        }
    }
} else {
    console.log("Claude Code: no user-level MCP config found (~/.claude.json)");
}

console.log("");

// --- Cursor ---
const cursorJson = readJson(path.join(home, ".cursor", "mcp.json"));
const projectCursorJson = readJson(path.join(cwd, ".cursor", "mcp.json"));

if (cursorJson?.mcpServers) {
    console.log("Cursor:");
    const servers = cursorJson.mcpServers;
    for (const [name, cfg] of Object.entries(servers)) {
        const transport = cfg.url ? "http" : "stdio";
        // We cannot programmatically detect Cursor disable state from JSON alone
        const pad = name.length < 16 ? " ".repeat(16 - name.length) : " ";
        console.log("  " + name + pad + "(user)   " + transport);
    }
    if (projectCursorJson?.mcpServers) {
        console.log("  Project overrides (.cursor/mcp.json):");
        for (const [name, cfg] of Object.entries(projectCursorJson.mcpServers)) {
            const transport = cfg.url ? "http" : "stdio";
            const pad = name.length < 16 ? " ".repeat(16 - name.length) : " ";
            console.log("    " + name + pad + "enabled   " + transport);
        }
    }
} else {
    console.log("Cursor: no user-level MCP config found (~/.cursor/mcp.json)");
}
'
    show_cloud_mcp mcp
    return 0
fi

# ---------------------------------------------------------------------------
# dashboard — mission control dashboard lifecycle
# ---------------------------------------------------------------------------

if $do_dashboard; then
    # Dashboard is a standalone script that handles its own logging and summary.
    # Dispatch to aitools-dashboard.sh (macOS) or aitools-dashboard.ps1 (Windows).
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            if ! command -v pwsh &>/dev/null; then
                log_error "pwsh (PowerShell 7) not found"
                return 1
            fi
            pwsh -NoProfile -ExecutionPolicy Bypass \
                -File "$(cygpath -w "$repo_path/scripts/aitools-dashboard.ps1")" \
                "${dashboard_args[@]}"
            ;;
        *)
            bash "$repo_path/scripts/aitools-dashboard.sh" "${dashboard_args[@]}"
            ;;
    esac
    return $?
fi

# ---------------------------------------------------------------------------
# --addmcp — enable MCP server(s) for current project
# ---------------------------------------------------------------------------

if [ ${#addmcp_servers[@]} -gt 0 ]; then
    # Validate all server names first
    for name in "${addmcp_servers[@]}"; do
        url=$(mcp_server_url "$name")
        if [ -z "$url" ]; then
            log_error "unknown MCP server '$name'"
            echo "Supported servers: vercel, webflow"
            return 1
        fi
    done

    # Warn if cwd doesn't look like a project
    if [ ! -d ".git" ] && [ ! -f "package.json" ] && [ ! -f "pyproject.toml" ]; then
        log_warn "current directory doesn't look like a project root"
        echo "  cwd: $(display_path "$(pwd)")"
        echo ""
    fi

    for name in "${addmcp_servers[@]}"; do
        url=$(mcp_server_url "$name")
        echo "Enabling $name for this project..."

        # --- Claude Code: .claude/settings.local.json (allow override) ---
        settings_local=".claude/settings.local.json"
        if command -v node &>/dev/null; then
            mkdir -p .claude
            node -e "
const fs = require('fs');
const f = process.argv[1];
let settings = {};
try { settings = JSON.parse(fs.readFileSync(f, 'utf8')); } catch (e) { if (e.code !== 'ENOENT') console.error('Warning: ' + f + ' is invalid JSON, starting with empty config'); }
if (!settings.permissions) settings.permissions = {};
if (!Array.isArray(settings.permissions.allow)) settings.permissions.allow = [];
const rule = 'MCP($name)';
if (!settings.permissions.allow.includes(rule)) {
    settings.permissions.allow.push(rule);
}
fs.writeFileSync(f, JSON.stringify(settings, null, 2) + '\n');

// Post-write validation
const _v = JSON.parse(fs.readFileSync(f, 'utf8'));
if (!_v.permissions) { console.error('Validation failed: missing permissions'); process.exit(1); }
" "$settings_local"
            echo "  Claude Code: $name enabled in $settings_local"
        else
            echo "  Claude Code: skipped (node not found)"
        fi

        # --- Cursor: try agent mcp enable, fall back to project .cursor/mcp.json ---
        cursor_done=false
        if command -v agent &>/dev/null; then
            if agent mcp enable "$name" 2>&1; then
                echo "  Cursor CLI: $name enabled (agent mcp enable)"
                cursor_done=true
            fi
        fi
        if ! $cursor_done && command -v node &>/dev/null; then
            cursor_mcp=".cursor/mcp.json"
            mkdir -p .cursor
            node -e "
const fs = require('fs');
const f = process.argv[1];
let cfg = {};
try { cfg = JSON.parse(fs.readFileSync(f, 'utf8')); } catch (e) { if (e.code !== 'ENOENT') console.error('Warning: ' + f + ' is invalid JSON, starting with empty config'); }
if (!cfg.mcpServers) cfg.mcpServers = {};
cfg.mcpServers['$name'] = { url: '$url' };
fs.writeFileSync(f, JSON.stringify(cfg, null, 2) + '\n');
" "$cursor_mcp"
            echo "  Cursor: $name added to $cursor_mcp"
        fi
        if ! $cursor_done && ! command -v node &>/dev/null; then
            echo "  Cursor: skipped (neither agent nor node found)"
        fi

        echo ""
    done

    echo "Done. MCP servers enabled for project at $(display_path "$(pwd)")"
    return 0
fi

# ---------------------------------------------------------------------------
# user — user repo management
# ---------------------------------------------------------------------------

if $do_user; then
    case "$user_subcmd" in
        init)
            # Decision 3: user init has its own run summary -- created before the user
            # block (its rows and those of its child scripts), shown before it returns
            AITOOLS_SUMMARY_FILE="$HOME/.aitools/run-summary.txt"
            rm -f "$AITOOLS_SUMMARY_FILE"
            if ! { mkdir -p "$HOME/.aitools" && touch "$AITOOLS_SUMMARY_FILE"; }; then
                log_warn "user init: could not create the run summary $(display_path "$AITOOLS_SUMMARY_FILE") -- the summary panel is not shown"
            fi
            export AITOOLS_SUMMARY_FILE
            user_init_rc=0
            user_init || user_init_rc=$?
            show_summary
            unset AITOOLS_SUMMARY_FILE
            return "$user_init_rc"
            ;;
        "")
            log_error "missing subcommand"
            echo "Usage: aitools user init"
            return 1
            ;;
        *)
            log_error "unknown subcommand 'user $user_subcmd'"
            echo "Usage: aitools user init"
            return 1
            ;;
    esac
fi

# ---------------------------------------------------------------------------
# sessions — session archive management
# ---------------------------------------------------------------------------

if $do_sessions; then
    # Resolve user repo path
    user_repo=""
    if raw=$(read_config_key "$config" "userRepoPath"); then
        user_repo=$(to_native_path "$raw")
    fi
    if [ -z "$user_repo" ] || [ ! -d "$user_repo" ]; then
        log_error "user repo not configured. Run 'aitools user init' first."
        return 1
    fi
    sessions_dir="$user_repo/sessions"

    case "$sessions_subcmd" in
        list)
            filter="${sessions_args[0]:-}"
            if [ ! -d "$sessions_dir" ]; then
                echo "No sessions archived yet."
                return 0
            fi
            found=false
            # Use a subshell+pipeline to iterate reliably
            while IFS= read -r file; do
                [ -z "$file" ] && continue
                rel="${file#"$sessions_dir/"}"
                project="${rel%%/*}"
                if [ -n "$filter" ] && [ "$project" != "$filter" ]; then
                    continue
                fi
                size=$(du -h "$file" | cut -f1 | tr -d ' ')
                printf '%s  (%s)\n' "$rel" "$size"
                found=true
            # sessions_dir may not exist; suppress find errors, checked via $found
            done < <(find "$sessions_dir" -name "*.jsonl" -type f 2>/dev/null | sort)
            if ! $found; then
                if [ -n "$filter" ]; then
                    echo "No sessions found for project '$filter'."
                else
                    echo "No sessions archived yet."
                fi
            fi
            ;;
        archive)
            session_id="${sessions_args[0]:-}"
            if [ -z "$session_id" ]; then
                log_error "session ID required"
                echo "Usage: aitools sessions archive <session-id>"
                return 1
            fi

            # Search for matching session in ~/.claude/projects/
            claude_projects="$HOME/.claude/projects"
            if [ ! -d "$claude_projects" ]; then
                log_error "no Claude Code sessions found at $claude_projects"
                return 1
            fi

            # Find matching JSONL file(s)
            matches=()
            while IFS= read -r f; do
                matches+=("$f")
            # claude_projects dir may not exist; suppress find errors, checked via matches count
            done < <(find "$claude_projects" -name "${session_id}*.jsonl" -type f 2>/dev/null)

            if [ ${#matches[@]} -eq 0 ]; then
                log_error "no session found matching '$session_id'"
                echo "Hint: check 'ls ~/.claude/projects/*/' for available sessions"
                return 1
            fi

            if [ ${#matches[@]} -gt 1 ]; then
                echo "Multiple sessions match '$session_id':"
                for m in "${matches[@]}"; do
                    echo "  $(basename "$m" .jsonl)"
                done
                echo "Provide a longer prefix to disambiguate."
                return 1
            fi

            transcript="${matches[0]}"
            full_id=$(basename "$transcript" .jsonl)

            # Delegate the actual archive (project derivation, subagents,
            # idempotent dest-exists, commit/push) to ait-harvest.py -- the
            # single source of truth shared with the SessionEnd hook.
            # Resolve a Python interpreter (existence check + explicit fallback).
            archive_py=""
            if command -v python3 >/dev/null 2>&1; then
                archive_py="python3"
            elif command -v python >/dev/null 2>&1; then
                archive_py="python"
            fi
            if [ -z "$archive_py" ]; then
                log_error "Python 3 not found; cannot archive"
                return 1
            fi
            archive_helper=""
            if [ -f "$repo_path/scripts/ait-harvest.py" ]; then
                archive_helper="$repo_path/scripts/ait-harvest.py"
            elif [ -f "$HOME/repos/aitools/scripts/ait-harvest.py" ]; then
                archive_helper="$HOME/repos/aitools/scripts/ait-harvest.py"
            fi
            if [ -z "$archive_helper" ]; then
                log_error "ait-harvest.py not found; cannot archive"
                return 1
            fi
            # No git push for a manual CLI archive (do_git left to the helper's
            # default; --no-op-on-missing handled inside). Pass the transcript.
            "$archive_py" "$archive_helper" archive \
                --session "$full_id" --transcript "$transcript"
            echo "Archive requested for $full_id (see ~/.aitools/logs/ait-harvest.log)"
            ;;
        move)
            src="${sessions_args[0]:-}"
            dest_project="${sessions_args[1]:-}"
            if [ -z "$src" ] || [ -z "$dest_project" ]; then
                log_error "source file and destination project required"
                echo "Usage: aitools sessions move <file> <project>"
                return 1
            fi

            # Resolve source path (relative to sessions dir or absolute)
            if [[ "$src" = /* ]]; then
                src_file="$src"
            else
                src_file="$sessions_dir/$src"
            fi

            if [ ! -f "$src_file" ]; then
                log_error "session file not found: $src"
                return 1
            fi

            dest_dir="$sessions_dir/$dest_project"
            dest_file="$dest_dir/$(basename "$src_file")"
            mkdir -p "$dest_dir"
            mv "$src_file" "$dest_file"
            echo "Moved: $(basename "$src_file") -> $dest_project/"
            echo "Note: Claude Code sessions are tied to the original working directory and cannot be moved."

            # Clean up empty source directory
            old_dir=$(dirname "$src_file")
            if [ -d "$old_dir" ] && [ -z "$(ls -A "$old_dir" 2>/dev/null)" ]; then
                rmdir "$old_dir"
            fi
            ;;
        "")
            log_error "missing subcommand"
            echo "Usage: aitools sessions list|archive|move"
            return 1
            ;;
        *)
            log_error "unknown subcommand 'sessions $sessions_subcmd'"
            echo "Usage: aitools sessions list|archive|move"
            return 1
            ;;
    esac
    return 0
fi

# ---------------------------------------------------------------------------
# Run update (pull + rebuild + deploy/install)
# ---------------------------------------------------------------------------

export AITOOLS_RUN_ID=$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')

# Init summary file for this run; child scripts append via AITOOLS_SUMMARY_FILE.
# SUPPRESS=1 tells aitools-install.sh not to display it (we display after it returns).
AITOOLS_SUMMARY_FILE="$HOME/.aitools/run-summary.txt"
rm -f "$AITOOLS_SUMMARY_FILE"
touch "$AITOOLS_SUMMARY_FILE"
export AITOOLS_SUMMARY_FILE
export AITOOLS_SUPPRESS_SUMMARY_DISPLAY=1

log "aitools $AITOOLS_INSTALLED_VERSION"

if $do_install; then
    STEPS=3
elif $do_gitpull; then
    STEPS=4
else
    # no-args: quiet pull + rebuild + deploy
    STEPS=3
fi

# --- Smart reload: skip steps 1-2 if re-execing after deploy list change ---
_prebuild_done=false
if [ "${AITOOLS_PREBUILD_DONE:-}" = "1" ]; then
    _prebuild_done=true
    pulled_updates=false
    [ "${AITOOLS_PULLED_UPDATES:-}" = "1" ] && pulled_updates=true
    unset AITOOLS_PREBUILD_DONE
    unset AITOOLS_PULLED_UPDATES
    log "Steps 1-2 already complete (reloaded)"
fi

if ! $_prebuild_done; then
# [1/N] Pull latest
if $do_gitpull; then
    log "Step 1/$STEPS: Pulling latest"
    pulled_updates=false
    # Reset generated files before pull (line-ending diffs, mode changes)
    git -C "$repo_path" checkout HEAD -- deploy/ 2>/dev/null || true
    if pull_out=$(cd "$repo_path" && git pull --tags origin main 2>&1); then
        if echo "$pull_out" | grep -q "Already up to date"; then
            log_ok "Already up to date"
        else
            pulled_updates=true
            log_ok "Updated"
        fi
    else
        while IFS= read -r _pull_line; do
            if [ -n "$_pull_line" ]; then log_detail "git-pull: $_pull_line"; fi
        done <<< "$pull_out"
        log_error "git pull failed (see $LOG_DISPLAY)"
        printf '%s\n' "$pull_out" >&2
        return 1
    fi
else
    # no-args and install: quiet pull (warn on failure, continue from local)
    log "Step 1/$STEPS: Pulling latest"
    pulled_updates=false
    # Reset generated files before pull (line-ending diffs, mode changes)
    git -C "$repo_path" checkout HEAD -- deploy/ 2>/dev/null || true
    if pull_out=$(cd "$repo_path" && git pull origin main 2>&1); then
        if echo "$pull_out" | grep -q "Already up to date"; then
            log_ok "Already up to date"
        else
            pulled_updates=true
            log_ok "Updated"
        fi
    else
        # Full output to the log first; the console keeps a 3-line preview.
        while IFS= read -r _pull_line; do
            if [ -n "$_pull_line" ]; then log_detail "git-pull: $_pull_line"; fi
        done <<< "$pull_out"
        if echo "$pull_out" | grep -qiE "could not resolve|unable to access|connection refused|connection timed out|no route to host"; then
            log_warn "Could not reach remote — deploying from local checkout"
        else
            log_warn "git pull failed -- deploying from local checkout (see $LOG_DISPLAY)"
            printf '%s\n' "$pull_out" | head -3 | sed 's/^/    /' >&2
        fi
        write_summary WARN "source" "stale local checkout (git pull failed)"
    fi
fi

# The dotprofile, as the resolver finds it (env, config.json, convention, scan):
# pulled here (quiet, non-blocking -- stale local data is better than failing) and
# passed to build-deploy below. A resolver error is logged with its ERROR row and
# ACTION by the lib; the build then resolves (and skips) on its own.
build_env=()
if resolve_user_repo_path; then
    user_repo_path="$AITLIB_USER_REPO_PATH"
    if [ -d "$user_repo_path/.git" ]; then
        ur_pull_exit=0
        ur_pull_out=$(git -C "$user_repo_path" pull --ff-only --quiet 2>&1) || ur_pull_exit=$?
        if [ "$ur_pull_exit" -ne 0 ]; then
            log_warn "user repo pull failed -- using local copy."
            log_detail "user-repo-pull: $ur_pull_out"
        fi
    fi
    # Forward slashes on Windows (C:/Users/...), the form Git Bash and pwsh both read
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            if _urp_m=$(cygpath -m "$user_repo_path"); then user_repo_path="$_urp_m"
            else log_detail "cygpath -m failed for $user_repo_path -- passed to build-deploy unchanged"; fi ;;
    esac
    build_env=(AITOOLS_USER_REPO_PATH="$user_repo_path")
fi

# [2/N] Rebuild deploy scripts. The dotprofile resolved above reaches the build as
# AITOOLS_USER_REPO_PATH, scoped to this one call (B5a Q1; PR #95 follow-up)
log "Step 2/$STEPS: Rebuilding deploy scripts"
if env ${build_env[@]+"${build_env[@]}"} bash "$repo_path/scripts/build-deploy.sh" >> "$LOG_FILE" 2>&1; then
    log_ok "Rebuilt"
else
    log_error "build failed (see $LOG_DISPLAY)"
    return 1
fi

# Check if repo has a different deploy list than the running binary.
# If so, self-update and re-exec so deploy_configs uses the current list.
# Cost when lists match: one perl comparison (~1ms). No extra work.
if [ -f "$repo_path/scripts/aitools" ]; then
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) _lp='local deploy_scripts=".*\.ps1"' ;;
        *) _lp='local deploy_scripts=".*\.sh"' ;;
    esac
    _repo_list=$(perl -ne "print if /^\s+$_lp/" "$repo_path/scripts/aitools" | tail -1)
    _self_list=$(perl -ne "print if /^\s+$_lp/" "$0" | tail -1)
    if [ -n "$_repo_list" ] && [ "$_repo_list" != "$_self_list" ]; then
        log "Deploy script list changed -- reloading entry point"
        _nv=$(repo_version "$repo_path")
        _syntax_rc=0
        _syntax_out=$(bash -n "$repo_path/scripts/aitools" 2>&1) || _syntax_rc=$?
        if [ "$_syntax_rc" -eq 0 ]; then
            sed "s/^AITOOLS_INSTALLED_VERSION=.*/AITOOLS_INSTALLED_VERSION=\"$_nv\"/" \
                "$repo_path/scripts/aitools" > "$HOME/.local/bin/aitools"
            chmod +x "$HOME/.local/bin/aitools"
            export AITOOLS_PREBUILD_DONE=1
            [ "$pulled_updates" = "true" ] && export AITOOLS_PULLED_UPDATES=1
            # Replay the ORIGINAL args (parse loop already shifted "$@" empty);
            # otherwise `install` degrades to the sync path on reload.
            exec "$HOME/.local/bin/aitools" ${_ORIG_ARGS[@]+"${_ORIG_ARGS[@]}"}
        else
            while IFS= read -r _syntax_line; do
                if [ -n "$_syntax_line" ]; then log_detail "aitools syntax: $_syntax_line"; fi
            done <<< "$_syntax_out"
            log_warn "Repo scripts/aitools has syntax errors -- continuing with current list (see $LOG_DISPLAY)"
        fi
    fi
fi

fi  # _prebuild_done

# Overall exit status: any failed installer/deploy step makes `aitools` exit non-zero
overall_rc=0

if $do_install; then
    # --- install: pull + rebuild + run installer (includes deploy) ---
    log "Step 3/$STEPS: Running installer"
    # Interactive iff run from a terminal: the installer and its setup scripts
    # inherit this stdin and decide for themselves. --force makes every review
    # prompt take the source version (backup kept), terminal or not.
    if $force; then export AITOOLS_FORCE=1; fi
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            # Windows: forward to PowerShell installer with translated flags
            ps_args=()
            local i=0
            while [ $i -lt ${#passthrough[@]} ]; do
                case "${passthrough[$i]}" in
                    --skip-gh-auth)         ps_args+=("-SkipGhAuth") ;;
                    --skip-drive-detection) ps_args+=("-SkipDriveDetection") ;;
                    --repos-path)
                        ps_args+=("-ReposPath")
                        i=$((i + 1))
                        ps_args+=("$(cygpath -w "${passthrough[$i]}")")
                        ;;
                    *) ps_args+=("${passthrough[$i]}") ;;
                esac
                i=$((i + 1))
            done
            pwsh -NoProfile -ExecutionPolicy Bypass \
                -File "$(cygpath -w "$repo_path/scripts/aitools-install.ps1")" \
                "${ps_args[@]}"
            ;;
        *)
            bash "$repo_path/scripts/aitools-install.sh" "${passthrough[@]}"
            ;;
    esac
    installer_rc=$?
    unset AITOOLS_FORCE
    echo ""
    # Exit 2 = the user chose [x]abort at a review menu (D-TS13): the run stops
    if [ $installer_rc -eq 2 ]; then
        log "Installer aborted by user at a review menu -- run stopped (exit 2)"
        show_summary
        return 2
    fi
    if [ $installer_rc -eq 0 ]; then
        log_ok "All up to date ($(repo_version "$repo_path"))"
        # Session archive hint (after final status line)
        if ! read_config_key "$config" "userRepoPath" >/dev/null 2>&1; then
            printf '\033[33mhint: To archive sessions across machines, run '\''aitools user init'\''.\033[0m\n'
        fi
        check_profile interactive
    else
        log "Completed with errors (see $LOG_DISPLAY)" "error"
        overall_rc=1
    fi

elif $do_gitpull; then
    # --- gitpull: pull + rebuild + deploy + changelog + version tag ---
    log "Step 3/$STEPS: Deploying configurations"
    deploy_configs "$repo_path/scripts"
    deploy_rc=$?
    # [x]abort in deploy-harness (D-TS13): show what ran and stop with exit 2
    if $deploy_aborted; then
        show_summary
        return 2
    fi
    if [ $deploy_rc -eq 0 ]; then
        log_ok "Done"
    else
        log "Completed with $deploy_rc error(s)" "error"
        overall_rc=1
    fi

    log "Step 4/$STEPS: Tagging version"
    # Skip if HEAD already has a tag (e.g., re-running gitpull without new commits)
    if git -C "$repo_path" describe --tags --match "v*" --exact-match HEAD >/dev/null 2>&1; then
        existing=$(git -C "$repo_path" describe --tags --match "v*" --exact-match HEAD 2>/dev/null)
        log_ok "HEAD already tagged ($existing) — skipping"
        tag="$existing"
    else
        latest_tag=$(git -C "$repo_path" describe --tags --match "v*" --abbrev=0 2>/dev/null || echo "v0.0.0")
        if $gitpull_patch; then
            # Patch bump: v0.14.0 → v0.14.1
            local major minor patch
            IFS='.' read -r major minor patch <<< "${latest_tag#v}"
            patch=$((patch + 1))
            tag="v${major}.${minor}.${patch}"
        else
            # Minor bump: v0.14.0 → v0.15.0 (existing default)
            latest_minor=${latest_tag#v0.}
            latest_minor=${latest_minor%%.*}
            next_minor=$((latest_minor + 1))
            tag="v0.${next_minor}.0"
        fi
        # Release notes gate: require a matching entry before tagging
        tag_short="${tag%%.0}"  # v0.18.0 -> v0.18, v0.18.1 stays v0.18.1
        if ! grep -q "^## ${tag} \|^## ${tag_short} " "$repo_path/RELEASE_NOTES.md" 2>/dev/null; then
            log_warn "RELEASE_NOTES.md has no entry for $tag -- skipping tag"
            log "Add a '## ${tag} -- Title ($(date -u +%Y-%m-%d))' section first"
            tag="(skipped)"
        else
            git -C "$repo_path" tag "$tag"
            if git -C "$repo_path" push origin "$tag" 2>/dev/null; then
                log_ok "Tagged $tag"
            else
                log_warn "Tagged $tag (local only -- push failed)"
            fi
        fi
    fi

    if $pulled_updates; then
        log_ok "Updated and deployed ($tag)"
        # Show date-formatted changelog (no hashes)
        cd "$repo_path" && git log --format='  %ad  %s' --date=short ORIG_HEAD..HEAD 2>/dev/null
    else
        log_ok "Deployed ($tag)"
    fi

else
    # --- no-args: quiet pull + rebuild + deploy ---
    log "Step 3/$STEPS: Deploying configurations"
    deploy_configs "$repo_path/scripts"
    deploy_rc=$?
    # [x]abort in deploy-harness (D-TS13): show what ran and stop with exit 2
    if $deploy_aborted; then
        show_summary
        return 2
    fi
    if [ $deploy_rc -eq 0 ]; then
        log_ok "Done"
    else
        log "Completed with $deploy_rc error(s)" "error"
        overall_rc=1
    fi

    log_ok "Configs deployed ($(repo_version "$repo_path"))"

    check_profile interactive

    # Session archive hint (after final status line)
    settings_file="$HOME/.claude/settings.json"
    hook_installed=false
    if [ -f "$settings_file" ] && grep -q "session-archive.sh" "$settings_file" 2>/dev/null; then
        hook_installed=true
    fi
    if [ "$hook_installed" = true ]; then
        if ! read_config_key "$config" "userRepoPath" >/dev/null 2>&1; then
            printf '\033[33mWARNING: session archive hook installed but inactive -- userRepoPath not configured. Run '\''aitools user init'\''.\033[0m\n'
        fi
    else
        printf '\033[33mhint: session archive hook not installed. Run '\''aitools user init'\'' to set up.\033[0m\n'
    fi
fi

# Self-update: bake version into installed copy AFTER installer
# (installer Step 6 copies the source file, so we must re-stamp after)
if [ -f "$repo_path/scripts/aitools" ]; then
    new_version=$(repo_version "$repo_path")

    # Validate bash syntax before overwriting installed copy
    _syntax_rc=0
    _syntax_out=$(bash -n "$repo_path/scripts/aitools" 2>&1) || _syntax_rc=$?
    if [ "$_syntax_rc" -eq 0 ]; then
        sed "s/^AITOOLS_INSTALLED_VERSION=.*/AITOOLS_INSTALLED_VERSION=\"$new_version\"/" \
            "$repo_path/scripts/aitools" > "$HOME/.local/bin/aitools"
        chmod +x "$HOME/.local/bin/aitools"
    else
        while IFS= read -r _syntax_line; do
            if [ -n "$_syntax_line" ]; then log_detail "aitools syntax: $_syntax_line"; fi
        done <<< "$_syntax_out"
        log_warn "skipping bash self-update (new aitools has syntax errors; see $LOG_DISPLAY)"
    fi

    # On Windows, also self-update aitools.ps1 (validate with current PS version first)
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            if [ -f "$repo_path/scripts/aitools.ps1" ]; then
                _parse_rc=0
                _parse_out=$(pwsh -NoProfile -Command "
                    \$e = \$null
                    \$null = [System.Management.Automation.Language.Parser]::ParseFile('$(cygpath -w "$repo_path/scripts/aitools.ps1")', [ref]\$null, [ref]\$e)
                    foreach (\$x in \$e) { 'line ' + \$x.Extent.StartLineNumber + ': ' + \$x.Message }
                    if (\$e.Count -gt 0) { exit 1 }
                " 2>&1) || _parse_rc=$?
                if [ "$_parse_rc" -eq 0 ]; then
                    sed 's/^\$AITOOLS_INSTALLED_VERSION = ".*"/$AITOOLS_INSTALLED_VERSION = "'"$new_version"'"/' \
                        "$repo_path/scripts/aitools.ps1" > "$HOME/.local/bin/aitools.ps1"
                else
                    while IFS= read -r _parse_line; do
                        if [ -n "$_parse_line" ]; then log_detail "aitools.ps1 parse: $_parse_line"; fi
                    done <<< "$_parse_out"
                    log_warn "skipping PS1 self-update (parse errors on this PowerShell version; see $LOG_DISPLAY)"
                fi
            fi
            ;;
    esac
fi

show_summary

# Relay outbound: prompt if relay.md is dirty or main is ahead of origin (cross-machine OL)
_rob="$repo_path/scripts/relay-outbound-prompt.sh"
if [ -f "$_rob" ]; then
    # shellcheck source=relay-outbound-prompt.sh
    # shellcheck disable=SC1090
    source "$_rob"
    relay_outbound_prompt "$repo_path" || return $?
fi

unset AITOOLS_RUN_ID
unset AITOOLS_SUMMARY_FILE
unset AITOOLS_SUPPRESS_SUMMARY_DISPLAY

return "$overall_rc"
}

main "$@"; exit
