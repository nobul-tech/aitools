+  | profile | 689/0 |
+  | lib | 209/0 |
+  | config | 190/0 |
+  | user-init | 200/0 |
+  | rules-fanout-cursor | 78/0, 1 skip |
+  | logging | 24/0 |
+  | deploy-harness | 45/0 |
