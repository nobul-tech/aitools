+# =========================================================================
+# 5b. Rules manifest (~/.aitools/rules/.aitools-rules-manifest), retired rules
+# =========================================================================
+# The rules fan-out consumers (setup-user-claude, setup-user-cursor) read it for
+# each rule's source and for the rules to retire. Format v1: UTF-8, LF, first
+# line "# aitools rules manifest v1", then "<file name><TAB><source>" sorted by
+# file name (byte order); source: shared (aitools shared/rules), aitools
+# (aitools .claude/rules), dotprofile (dotprofile claude/rules), retired. The
+# source is the one that won (first source wins). No .md extension: consumers
+# that copy *.md never copy it.
+# Retired: a name in the previous manifest that no source has this run (names
+# compared case-insensitively). Only a source listed this run can retire its
+# names; a name whose source was not listed (not found, not a git checkout,
+# ls-files failed, no dotprofile) keeps its line. A retired name's file in
+# ~/.aitools/rules is backed up and removed (on every run while it is there);
+# the line stays until a source has the name again. No previous manifest
+# (first run): nothing is retired. A previous manifest with another header:
+# warning, nothing retired, rewritten.
+RULES_MANIFEST_HEADER="# aitools rules manifest v1"
+N_RETIRED=0
+
+# rules_manifest_plan PREV NEW ACTIONS -- from $SEEN (rule winners), $LISTED and
+# the previous manifest PREV (may be absent): write the new manifest to NEW and
+# one action per line to ACTIONS: "retire<TAB>name<TAB>was" (retired this run),
+# "stale<TAB>name" (retired before), "keep<TAB>name<TAB>source" (source not
+# listed this run), "warn<TAB>message". Exit non-zero (message on stderr) on
+# any read or write failure.
+rules_manifest_plan() {
+    perl -e '
+        my ($seen, $listed, $prev, $new, $actions, $header) = @ARGV;
+        my %source_of = ("shared/rules" => "shared", ".claude/rules" => "aitools", "dotprofile" => "dotprofile");
+        my %label_of = reverse %source_of;
+        my (%lines, %claimed, %listed);
+        open my $s, "<:raw", $seen or die "cannot read $seen: $!\n";
+        while (my $l = <$s>) {
+            chomp $l;
+            my ($kind, $lc, $label, $unit) = split /\t/, $l, 4;
+            next unless $kind eq "rules";
+            my $src = $source_of{$label};
+            die "unknown rules source label: $label\n" unless defined $src;
+            $lines{$unit} = $src;
+            $claimed{lc $unit} = 1;
+        }
+        close $s;
+        open my $ls, "<:raw", $listed or die "cannot read $listed: $!\n";
+        while (my $l = <$ls>) { chomp $l; $listed{$l} = 1; }
+        close $ls;
+        open my $a, ">:raw", $actions or die "cannot write $actions: $!\n";
+        if (-e $prev) {
+            open my $p, "<:raw", $prev or die "cannot read $prev: $!\n";
+            my $head = <$p>;
+            $head = "" unless defined $head;
+            $head =~ s/\A\xEF\xBB\xBF//;   # a UTF-8 BOM (as the .ps1 reader skips it)
+            $head =~ s/\r?\n\z//;
+            if ($head ne $header) {
+                print $a "warn\tthe first line is not \"$header\" -- nothing retired this run\n";
+            } else {
+                while (my $l = <$p>) {
+                    $l =~ s/\r?\n\z//;
+                    next if $l eq "";
+                    my ($name, $src) = split /\t/, $l, 2;
+                    $src = "" unless defined $src;
+                    if ($name !~ /\.md\z/ || $name =~ /\.bak\./ || $name =~ m{[/\\]}
+                            || $src !~ /\A(?:shared|aitools|dotprofile|retired)\z/) {
+                        (my $show = $l) =~ s/\t/<TAB>/g;
+                        print $a "warn\tline ignored: $show\n";
+                        next;
+                    }
+                    next if $claimed{lc $name};          # a source has it this run
+                    if ($src eq "retired") {
+                        $lines{$name} = "retired";
+                        print $a "stale\t$name\n";
+                    } elsif ($listed{$label_of{$src}}) {
+                        $lines{$name} = "retired";
+                        print $a "retire\t$name\t$src\n";
+                    } else {
+                        $lines{$name} = $src;
+                        print $a "keep\t$name\t$src\n";
+                    }
+                }
+            }
+            close $p;
+        }
+        close $a or die "cannot write $actions: $!\n";
+        open my $n, ">:raw", $new or die "cannot write $new: $!\n";
+        print $n "$header\n";
+        print $n "$_\t$lines{$_}\n" for sort keys %lines;
+        close $n or die "cannot write $new: $!\n";
+    ' "$SEEN" "$LISTED" "$1" "$2" "$3" "$RULES_MANIFEST_HEADER"
+}
