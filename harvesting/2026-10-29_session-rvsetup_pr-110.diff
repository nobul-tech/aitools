+        log_error "Rules manifest: cannot move $(display_path "$tmp") to $(display_path "$manifest") -- manifest not written"
+        write_summary ERROR "$TOOL" "rules manifest not written"
+        if ! rm -f "$tmp"; then log_warn "Cannot remove $(display_path "$tmp")"; fi
+        return 0
+    fi
+    log "Rules manifest: wrote $(display_path "$manifest") ($n rule line(s))"
