+# =========================================================================
+# 5b. Rules manifest (.aitools\rules\.aitools-rules-manifest), retired rules
+# =========================================================================
+# The rules fan-out consumers (setup-user-claude, setup-user-cursor) read it for
+# each rule's source and for the rules to retire. Format v1: UTF-8, LF, first
+# line "# aitools rules manifest v1", then "<file name><TAB><source>" sorted by
+# file name (ordinal); source: shared (aitools shared/rules), aitools (aitools
+# .claude/rules), dotprofile (dotprofile claude/rules), retired. The source is
+# the one that won (first source wins). No .md extension: consumers that copy
+# *.md never copy it.
+# Retired: a name in the previous manifest that no source has this run (names
+# compared case-insensitively). Only a source listed this run can retire its
+# names; a name whose source was not listed (not found, not a git checkout,
+# ls-files failed, no dotprofile) keeps its line. A retired name's file in
+# .aitools\rules is backed up and removed (on every run while it is there);
+# the line stays until a source has the name again. No previous manifest
+# (first run): nothing is retired. A previous manifest with another header:
+# warning, nothing retired, rewritten. Same outcomes as deploy-harness.sh.
+$rulesManifestHeader = "# aitools rules manifest v1"
+$nRetired = 0
+
+# Get-RulesManifestPlan PREV -- from $seen (rule winners), $listed and the
+# previous manifest PREV (may be absent): @{ Lines = sorted manifest lines;
+# Actions = list of @{ Kind = retire|stale|keep|warn; Name; Extra } }.
+# Throws on a read failure.
+function Get-RulesManifestPlan([string]$Prev) {
+    $sourceOf = @{ "shared/rules" = "shared"; ".claude/rules" = "aitools"; "dotprofile" = "dotprofile" }
+    $labelOf = @{ "shared" = "shared/rules"; "aitools" = ".claude/rules"; "dotprofile" = "dotprofile" }
+    $lines = [System.Collections.Generic.Dictionary[string, string]]::new([StringComparer]::Ordinal)
+    $claimed = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
+    $actions = [System.Collections.Generic.List[object]]::new()
+    foreach ($k in @($seen.Keys)) {
+        if (-not $k.StartsWith("rules|")) { continue }
+        $w = $seen[$k]
+        if (-not $sourceOf.ContainsKey($w.Label)) { throw "unknown rules source label: $($w.Label)" }
+        $lines[$w.Unit] = $sourceOf[$w.Label]
+        [void]$claimed.Add($w.Unit)
+    }
+    if (Test-Path -LiteralPath $Prev -PathType Leaf) {
+        $prevLines = [IO.File]::ReadAllLines($Prev, [System.Text.UTF8Encoding]::new($false))
+        if ($prevLines.Count -eq 0 -or $prevLines[0] -cne $rulesManifestHeader) {
+            $actions.Add(@{ Kind = "warn"; Name = "the first line is not `"$rulesManifestHeader`" -- nothing retired this run"; Extra = "" })
+        } else {
+            foreach ($l in ($prevLines | Select-Object -Skip 1)) {
+                if ($l -eq "") { continue }
+                $parts = $l -split "`t", 2
+                $name = $parts[0]
+                $src = if ($parts.Count -gt 1) { $parts[1] } else { "" }
+                if ($name -cnotlike '*.md' -or $name -clike '*.bak.*' -or $name -match '[/\\]' -or
+                        $src -cnotmatch '\A(?:shared|aitools|dotprofile|retired)\z') {
+                    $actions.Add(@{ Kind = "warn"; Name = "line ignored: $($l -replace "`t", '<TAB>')"; Extra = "" })
+                    continue
+                }
+                if ($claimed.Contains($name)) { continue }          # a source has it this run
+                if ($src -ceq "retired") {
+                    $lines[$name] = "retired"
+                    $actions.Add(@{ Kind = "stale"; Name = $name; Extra = "" })
+                } elseif ($listed.ContainsKey($labelOf[$src])) {
+                    $lines[$name] = "retired"
+                    $actions.Add(@{ Kind = "retire"; Name = $name; Extra = $src })
+                } else {
+                    $lines[$name] = $src
+                    $actions.Add(@{ Kind = "keep"; Name = $name; Extra = $src })
+                }
+            }
+        }
+    }
+    $names = [string[]]@($lines.Keys)
+    [Array]::Sort($names, [StringComparer]::Ordinal)
+    $out = [System.Collections.Generic.List[string]]::new()
+    foreach ($n in $names) { $out.Add("$n`t$($lines[$n])") }
+    return @{ Lines = $out; Actions = $actions }
+}
+
+# Remove-RetiredRule NAME -- back up and remove .aitools\rules\NAME (a retired rule)
+function Remove-RetiredRule([string]$Name) {
+    $f = Join-Path (Join-Path $harnessDir "rules") $Name
+    if ($DryRun) {
+        Log "[DRY RUN] Would back up and remove $f (retired rule)"
+        return
+    }
+    # Not Backup-File: it resolves wildcards ([ ] in a rule name), finds nothing
+    # and reports success. Same name as backup_file: <file>.bak.<UTC timestamp>.
+    $bak = "$f.bak." + (Get-Date).ToUniversalTime().ToString("yyyy-MM-ddTHHmmssZ")
+    $backupOk = $true
+    try {
+        Copy-Item -LiteralPath $f -Destination $bak -Force -ErrorAction Stop
+    } catch {
+        $backupOk = $false
+        LogDetail "Retired rule ${Name}: backup copy failed: $_"
+    }
+    if (-not $backupOk -or -not (Test-Path -LiteralPath $bak -PathType Leaf)) {
+        LogError "Retired rule ${Name}: backup failed -- $f not removed"
+        Write-Summary "ERROR" $tool (Get-ShortDetail "retire failed: $Name")
+        return
+    }
+    Log "Backed up $f"
+    try {
+        Remove-Item -LiteralPath $f -Force -ErrorAction Stop
+    } catch {
+        LogError "Retired rule ${Name}: cannot remove ${f}: $_"
+        Write-Summary "ERROR" $tool (Get-ShortDetail "retire failed: $Name")
+        return
+    }
+    $script:nRetired++
