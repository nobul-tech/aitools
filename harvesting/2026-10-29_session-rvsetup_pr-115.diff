+    Setup-Case "direct-preresolved"; W "dotprofile/claude/rules/r.md" "edited"
+    Run-Lib ("`$script:AitLibUserRepoPath = ''; " + (Dcp "$DP/claude/rules/r.md" "Adopt r.md"))
