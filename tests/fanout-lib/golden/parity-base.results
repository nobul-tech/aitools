t-removed	DETAIL|t|removed: a.md ;; OK|t|1 removed ;; text=1 removed ;; errors=0
t-unknown	DETAIL|t|failed: b.md ;; ERROR|t|1 failed ;; text=1 failed ;; errors=1
t-blank	DETAIL|t|failed: x.md ;; ERROR|t|1 failed ;; text=1 failed ;; errors=1
t-mix	DETAIL|t|added: a.md ;; DETAIL|t|removed: b.md ;; DETAIL|t|failed: d.md ;; ERROR|t|1 failed ;; text=1 added, 1 removed, 1 verified, 1 failed ;; errors=1
t-order	DETAIL|t|accept & adopt: a.md ;; DETAIL|t|removed: b.md ;; DETAIL|t|updated: d.md ;; DETAIL|t|added: e.md ;; OK|t|1 added, 1 updated, 1 accepted, 1 removed, 1 verified ;; text=1 added, 1 updated, 1 accepted, 1 removed, 1 verified ;; errors=0
t-skip	DETAIL|t|removed: a.md ;; DETAIL|t|skipped: b.md ;; WARN|t|1 skipped (user review) ;; text=1 removed ;; errors=0
t-preserved	OK|t|n/a (nothing to deploy) ;; text=n/a (nothing to deploy) ;; errors=0
t-skiponly	DETAIL|t|skipped: a.md ;; WARN|t|1 skipped (user review) ;; text=n/a (nothing to deploy) ;; errors=0
t-case	DETAIL|t|failed: x.md ;; DETAIL|t|failed: y.md ;; DETAIL|t|failed: z.md ;; ERROR|t|3 failed ;; text=3 failed ;; errors=3
