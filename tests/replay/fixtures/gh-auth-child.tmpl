#!/usr/bin/env bash
# gh-auth child -- generated by tests/replay/test-replay.sh from this template:
# the line @INSTALLER_STEP2@ below is replaced by Step 2 ("Authenticate gh") of
# scripts/aitools-install.sh, copied verbatim from the temp aitools copy at test
# time, so the installer's own code (gh auth login </dev/tty >/dev/tty 2>&1)
# runs inside a relayed child on a pseudo-terminal. The variables the block
# reads are set as the installer sets them on an interactive run.
# Environment: REPLAY_LIB (aitools-lib.sh of the temp aitools copy); gh is the
# harness's stub (first on PATH).

set -euo pipefail

# shellcheck source=/dev/null
. "${REPLAY_LIB:?REPLAY_LIB is not set}"
logging_init "aitools-install"

SKIP_GH_AUTH=false
INSTALL_INTERACTIVE=true

@INSTALLER_STEP2@

if [ "$ERRORS" -gt 0 ]; then
    log "FAILED with $ERRORS error(s)" "error"
    exit 1
elif [ "$WARNINGS" -gt 0 ]; then
    log "COMPLETED with $WARNINGS warning(s)" "warn"
    exit 0
else
    log "COMPLETED successfully" "ok"
    exit 0
fi
